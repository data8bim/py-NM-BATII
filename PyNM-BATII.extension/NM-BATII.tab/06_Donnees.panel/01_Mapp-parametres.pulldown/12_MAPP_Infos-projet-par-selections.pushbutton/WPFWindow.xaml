<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Informations Projet -> Objets (sélection)"
        Width="700" Height="560"
        MinWidth="520" MinHeight="420"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>  <!-- 0 : Bandeau info -->
      <RowDefinition Height="6"/>
      <RowDefinition Height="Auto"/>  <!-- 2 : En-têtes colonnes -->
      <RowDefinition Height="Auto"/>  <!-- 3 : Filtres / tri -->
      <RowDefinition Height="4"/>
      <RowDefinition Height="*"/>     <!-- 5 : Zone de mappages -->
      <RowDefinition Height="6"/>
      <RowDefinition Height="Auto"/>  <!-- 7 : Groupes boutons -->
      <RowDefinition Height="6"/>
      <RowDefinition Height="Auto"/>  <!-- 9 : Boutons bas -->
    </Grid.RowDefinitions>

    <!-- ═══ Bandeau informatif ════════════════════════════════════════════════
         Explique comment utiliser ce script et pointer vers l'autre script
         pour créer/enregistrer des configurations.
    ═══════════════════════════════════════════════════════════════════════ -->
    <Border Grid.Row="0"
            Background="#EEF4FB" BorderBrush="#A8C8E8"
            BorderThickness="1" CornerRadius="3" Padding="8,6">
      <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#2C5F8A">
        <Run FontWeight="SemiBold">Mode sélection :</Run>
        <Run>cliquez sur</Run>
        <Run FontWeight="SemiBold">⊕ Sélectionner</Run>
        <Run>pour choisir des objets dans Revit, puis sur</Run>
        <Run FontWeight="SemiBold">▶ Appliquer</Run>
        <Run>pour transférer les valeurs.</Run>
        <LineBreak/>
        <Run>Pour créer ou enregistrer des configurations de mappage, utilisez le script</Run>
        <Run FontWeight="SemiBold">« Infos Projet → Objets par catégories ».</Run>
        <Run>Vous pouvez charger ici un fichier de configuration issu de ce script</Run>
        <Run FontStyle="Italic">(les catégories seront ignorées).</Run>
      </TextBlock>
    </Border>

    <!-- ═══ En-têtes colonnes ════════════════════════════════════════════════ -->
    <Border Grid.Row="2"
            Background="#F4F4F4" BorderBrush="LightGray"
            BorderThickness="1" CornerRadius="3" Padding="6,5">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="30"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="32"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="Paramètre source (Informations Projet)"
                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0"/>
        <TextBlock Grid.Column="1" Text="→"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray"/>
        <TextBlock Grid.Column="2" Text="Paramètre cible (sur les objets sélectionnés)"
                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0"/>
      </Grid>
    </Border>

    <!-- ═══ Filtres et tri ════════════════════════════════════════════════════ -->
    <Grid Grid.Row="3" Margin="0,4,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="30"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="32"/>
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0">
        <Button x:Name="btnSortSrc" DockPanel.Dock="Right"
                Content="⇅" Width="34" Margin="3,0,0,0"
                ToolTip="Trier par paramètre source (⇅ / A→Z / Z→A)"/>
        <TextBox x:Name="searchSrc" Height="24" VerticalContentAlignment="Center"
                 ToolTip="Filtrer les mappages dont le paramètre source contient ce texte"/>
      </DockPanel>

      <DockPanel Grid.Column="2">
        <Button x:Name="btnSortTgt" DockPanel.Dock="Right"
                Content="⇅" Width="34" Margin="3,0,0,0"
                ToolTip="Trier par paramètre cible (⇅ / A→Z / Z→A)"/>
        <TextBox x:Name="searchTgt" Height="24" VerticalContentAlignment="Center"
                 Margin="4,0,0,0"
                 ToolTip="Filtrer les mappages dont le paramètre cible contient ce texte"/>
      </DockPanel>
    </Grid>

    <!-- ═══ Zone de mappages ══════════════════════════════════════════════════ -->
    <ScrollViewer Grid.Row="5"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="mappingsPanel"/>
    </ScrollViewer>

    <!-- ═══ Groupes de boutons ════════════════════════════════════════════════ -->
    <Grid Grid.Row="7">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- GroupBox Mappages -->
      <GroupBox Grid.Column="0" Header="Mappages">
        <Grid Margin="4,4,4,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" x:Name="btnAdd"
                  Content="＋  Ajouter un mappage" Height="26"
                  ToolTip="Ajouter une nouvelle règle de mappage"/>
          <Button Grid.Column="2" x:Name="btnClearAll"
                  Content="Supprimer tous les mappages" Height="26"
                  ToolTip="Supprimer toutes les lignes de mappage"/>
        </Grid>
      </GroupBox>

      <!-- GroupBox Configuration (Charger uniquement, pas d'Enregistrer) -->
      <GroupBox Grid.Column="2" Header="Configuration">
        <Grid Margin="4,4,4,6">
          <Button x:Name="btnLoad"
                  Content="📂  Charger" Height="26"
                  ToolTip="Charger un fichier de configuration JSON (issu du script Infos Projet → Objets par catégories)"/>
        </Grid>
      </GroupBox>
    </Grid>

    <!-- ═══ Boutons bas ════════════════════════════════════════════════════════ -->
    <Grid Grid.Row="9">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <!-- Statut de la sélection courante -->
      <Border Grid.Column="0"
              Background="#F0F6FF" BorderBrush="#B8D4F0"
              BorderThickness="1" CornerRadius="3" Padding="8,0"
              VerticalAlignment="Center" Margin="0,0,8,0">
        <TextBlock x:Name="txtSelCount"
                   Text="Aucun objet sélectionné"
                   FontSize="11" Foreground="#2C5F8A"
                   VerticalAlignment="Center" Height="32"
                   Padding="0,8,0,0"/>
      </Border>

      <!-- Boutons d'action -->
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="btnSelect"
                Content="⊕  Sélectionner" Width="130" Height="32"
                Margin="0,0,8,0"
                ToolTip="Minimise la fenêtre et vous permet de sélectionner des objets dans Revit (Multiple / Terminer / Annuler)"/>
        <Button x:Name="btnApply"
                Content="▶  Appliquer" Width="120" Height="32"
                Style="{DynamicResource NMButtonValide}"
                IsDefault="True" Margin="0,0,8,0"
                ToolTip="Copier les valeurs des Informations Projet vers les paramètres des objets sélectionnés"/>
        <Button x:Name="btnClose"
                Content="Fermer" Width="90" Height="32"
                Style="{DynamicResource NMButtonValide}"
                IsCancel="True"/>
      </StackPanel>
    </Grid>

  </Grid>
</Window>
