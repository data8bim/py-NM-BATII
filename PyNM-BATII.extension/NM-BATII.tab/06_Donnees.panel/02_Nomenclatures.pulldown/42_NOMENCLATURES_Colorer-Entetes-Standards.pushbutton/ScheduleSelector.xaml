<?xml version="1.0" encoding="utf-8"?>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sélectionner les nomenclatures"
        Height="600" Width="600"
        MinHeight="400" MinWidth="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    
    <Window.Resources>
        <!-- Styles UNIQUEMENT pour les boutons -->
        <Style x:Key="BoutonAction" TargetType="Button" BasedOn="{StaticResource NMButtonStandard}">
            <Setter Property="Height" Value="30"/>
        </Style>
        <Style x:Key="BoutonSuivant" TargetType="Button" BasedOn="{StaticResource NMButtonValide}">
            <Setter Property="Height" Value="40"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Zone de recherche (identique à pyRevit) -->
        <Grid Grid.Row="0" Margin="10,10,10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Bouton AZ (désactivé comme dans pyRevit) -->
            <ToggleButton x:Name="btnSearchMode" 
                          Grid.Column="0"
                          Width="40" 
                          Height="25"
                          IsEnabled="False"
                          Margin="0,0,5,0">
                <TextBlock Text="AZ" 
                           FontWeight="Bold"
                           FontSize="11"/>
            </ToggleButton>
            
            <!-- Zone de recherche -->
            <TextBox x:Name="txtSearch" 
                     Grid.Column="1"
                     Height="25"
                     VerticalContentAlignment="Center"/>
        </Grid>
        
        <!-- Liste des nomenclatures (style standard Windows) -->
        <ListBox x:Name="lstSchedules" 
                 Grid.Row="1"
                 Margin="10,0,10,5"
                 SelectionMode="Multiple"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="0"
                                        Padding="5,3,5,3">
                                    <CheckBox Content="{TemplateBinding Content}"
                                              IsChecked="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              IsHitTestVisible="False"
                                              Focusable="False"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E5F3FF"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F0F0F0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
        
        <!-- Boutons d'action -->
        <Grid Grid.Row="2" Margin="10,0,10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Button x:Name="btnCheckAll" 
                    Grid.Column="0"
                    Content="Tout sélectionner" 
                    Style="{StaticResource BoutonAction}"
                    Margin="0,0,2,0"/>
            <Button x:Name="btnUncheckAll" 
                    Grid.Column="1"
                    Content="Tout désélectionner" 
                    Style="{StaticResource BoutonAction}"
                    Margin="2,0,2,0"/>
            <Button x:Name="btnToggleAll" 
                    Grid.Column="2"
                    Content="Inverser" 
                    Style="{StaticResource BoutonAction}"
                    Margin="2,0,0,0"/>
        </Grid>
        
        <!-- Bouton Suivant -->
        <Button x:Name="btnOk" 
                Grid.Row="3"
                Content="Suivant" 
                Style="{StaticResource BoutonSuivant}"
                Margin="10,0,10,10"
                IsDefault="True"/>
    </Grid>
</Window>
