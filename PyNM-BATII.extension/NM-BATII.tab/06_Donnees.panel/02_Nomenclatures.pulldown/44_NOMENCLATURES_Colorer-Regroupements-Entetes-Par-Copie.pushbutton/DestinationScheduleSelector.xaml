<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copier couleurs regroupements - Sélection CIBLES"
        Width="600" Height="680"
        MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Window.Resources>
        <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFF"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#FFDDDDDD"/>
        <SolidColorBrush x:Key="PanelTitleBrush" Color="#FF222222"/>

        <Style x:Key="BoutonAction" TargetType="Button" BasedOn="{StaticResource NMButtonStandard}">
            <Setter Property="Height" Value="30"/>
        </Style>
        <Style x:Key="BoutonAppliquer" TargetType="Button" BasedOn="{StaticResource NMButtonValide}">
            <Setter Property="Height" Value="40"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12" Background="{DynamicResource DialogBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titre -->
        <TextBlock Grid.Row="0"
                   Text="Nomenclatures CIBLES"
                   FontSize="14" FontWeight="Bold" Margin="0,0,0,4"
                   Foreground="{DynamicResource PanelTitleBrush}"/>

        <!-- Message d'instruction -->
        <TextBlock Grid.Row="1"
                   Margin="0,0,0,10"
                   TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="#555555">
            <Run Text="Sélectionnez les nomenclatures sur lesquelles appliquer les couleurs de regroupements."/>
            <LineBreak/>
            <Run Text="Les regroupements avec le même nom recevront les couleurs de la source."/>
        </TextBlock>

        <!-- Zone de recherche -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ToggleButton x:Name="btnSearchMode"
                          Grid.Column="0"
                          Width="40" Height="25"
                          IsEnabled="False"
                          Margin="0,0,5,0">
                <TextBlock Text="AZ" FontWeight="Bold" FontSize="11"/>
            </ToggleButton>

            <TextBox x:Name="txtSearch"
                     Grid.Column="1"
                     Height="25"
                     VerticalContentAlignment="Center"/>
        </Grid>

        <!-- Liste avec checkboxes -->
        <Border Grid.Row="3"
                Background="{DynamicResource PanelBackgroundBrush}"
                Padding="8" CornerRadius="4"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="1">
            <ListBox x:Name="lstSchedules"
                     SelectionMode="Single"
                     BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        </Border>

        <!-- Boutons d'action -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnCheckAll"
                    Grid.Column="0"
                    Content="Tout sélectionner"
                    Style="{StaticResource BoutonAction}"
                    Margin="0,0,2,0"/>
            <Button x:Name="btnUncheckAll"
                    Grid.Column="1"
                    Content="Tout désélectionner"
                    Style="{StaticResource BoutonAction}"
                    Margin="2,0,2,0"/>
            <Button x:Name="btnToggleAll"
                    Grid.Column="2"
                    Content="Inverser"
                    Style="{StaticResource BoutonAction}"
                    Margin="2,0,0,0"/>
        </Grid>

        <!-- Bouton Appliquer -->
        <Button x:Name="btnOk"
                Grid.Row="5"
                Content="Appliquer les couleurs"
                Style="{StaticResource BoutonAppliquer}"
                Margin="0,8,0,0"
                IsDefault="True"/>
    </Grid>
</Window>
