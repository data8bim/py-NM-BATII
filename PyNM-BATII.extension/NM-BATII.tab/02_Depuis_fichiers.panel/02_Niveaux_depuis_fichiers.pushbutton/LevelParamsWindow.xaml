<?xml version="1.0" encoding="utf-8"?>

<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Paramètres Niveaux"
	SizeToContent="WidthAndHeight"
	Width="500"
	Height="400"
	ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen">
	
    <Window.Resources>
        <Style TargetType="Window" BasedOn="{StaticResource NMWindowStandard}" />
        <Style TargetType="TextBlock" BasedOn="{StaticResource NMTextBlockStandard}" />
		<Style TargetType="TextBox" BasedOn="{StaticResource NMTextBoxStandard}" />
        <Style TargetType="Button" BasedOn="{StaticResource NMButtonStandard}" />
        <Style x:Key="NMButtonValideOnly" TargetType="Button" BasedOn="{StaticResource NMButtonValide}" />

    </Window.Resources> 	

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
			<RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
			<ColumnDefinition Width="*" MinWidth="60"/>
        </Grid.ColumnDefinitions>

		<TextBlock	Text="Espacement entre niveaux (m) :"
					Grid.Row="0"
					Grid.Column="0" Grid.ColumnSpan="2"
					VerticalAlignment="Center"/>		
				   
        <TextBox	x:Name="txtEspacement"
					TextAlignment="Center"
					VerticalContentAlignment="Center"
					Padding="2"
					IsReadOnly="False"
					Grid.Row="0"
					Grid.Column="2"
					VerticalAlignment="Center"/>

        <CheckBox	x:Name="chkOrigin"
					Content="Créer le niveau Origine"
					IsChecked="True"
					Margin="5,15,0,5"
					Grid.Row="1"
					Grid.Column="0" Grid.ColumnSpan="3"/>


		<Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0">
			<Grid.RowDefinitions>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="5"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<Button	x:Name="btnOk"
					Content="Valider"
					Style="{StaticResource NMButtonValideOnly}"
					Grid.Row="0"
					Grid.Column="0"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Stretch"/>
					
			<Button	x:Name="btnCancel"
					Content="Annuler"
					IsCancel="True"
					Style="{StaticResource NMButtonValideOnly}"
					Grid.Row="0"
					Grid.Column="2"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Stretch"/>
			</Grid>

    </Grid>
</Window>
