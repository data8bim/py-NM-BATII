<?xml version="1.0" encoding="utf-8"?>

<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Sélection des vues"
    SizeToContent="WidthAndHeight"
    MinWidth="500"
	MaxWidth="700"
	MinHeight="400"
	MaxHeight="600"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <Style TargetType="Window" BasedOn="{StaticResource NMWindowStandard}" />
        <Style TargetType="TextBlock" BasedOn="{StaticResource NMTextBlockStandard}" />
        <Style TargetType="Button" BasedOn="{StaticResource NMButtonStandard}" />
        <Style x:Key="NMButtonValideOnly" TargetType="Button" BasedOn="{StaticResource NMButtonValide}" />
		<Style TargetType="ComboBox" BasedOn="{StaticResource NMComboBoxStandard}" />
		<Style TargetType="ListBox" BasedOn="{StaticResource NMListBoxStandard}" />
    </Window.Resources>    

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
			<RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
			<RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
		

        <TextBlock	Text="Type de vue à créer :"
					Grid.Row="0"
					Grid.Column="0" Grid.ColumnSpan="3"/>

        <ComboBox	x:Name="cmbViewFamily"
					Grid.Row="1"
					Grid.Column="0" Grid.ColumnSpan="3"/>

        <TextBlock	Text="Cochez les vues à créer :"
					Grid.Row="3"
					Grid.Column="0" Grid.ColumnSpan="3"/>

		<ListBox
			x:Name="lstViews"
			SelectionMode="Multiple"
			HorizontalContentAlignment="Stretch"
			Grid.Row="4"
			Grid.Column="0" Grid.ColumnSpan="3">
    
			<ListBox.ItemTemplate>
				<DataTemplate>
					<CheckBox
						Content="{Binding}"
						IsChecked="{Binding IsSelected,
									RelativeSource={RelativeSource AncestorType=ListBoxItem},
									Mode=TwoWay}" />
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>

        <Button x:Name="btnSelectAll"
				Content="Sélectionner tout"
				Grid.Row="5"
				Grid.Column="0"/>
				
        <Button x:Name="btnDeselectAll"
				Content="Désélectionner tout"
				Grid.Row="5"
				Grid.Column="1"/>
				
        <Button x:Name="btnInvert"
				Content="Inverser la sélection"
				Grid.Row="5"
				Grid.Column="2"/>

        <Button x:Name="btnOk"
				Content="Créer"
				Style="{StaticResource NMButtonValideOnly}"
				Grid.Row="7"
				Grid.Column="1"/>
				
        <Button x:Name="btnCancel"
				Content="Annuler"
				Style="{StaticResource NMButtonValideOnly}"
				IsCancel="True"
				Grid.Row="7"
				Grid.Column="2"/>
    </Grid>
</Window>
