<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sélection de Notes Textuelles"
        Width="960" Height="660"
        MinWidth="700" MinHeight="460"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>  <!-- 0 : En-tête tableau -->
      <RowDefinition Height="*"/>     <!-- 1 : Corps tableau -->
      <RowDefinition Height="6"/>
      <RowDefinition Height="Auto"/>  <!-- 3 : Compteur -->
      <RowDefinition Height="6"/>
      <RowDefinition Height="Auto"/>  <!-- 5 : Boutons sélection -->
      <RowDefinition Height="6"/>
      <RowDefinition Height="Auto"/>  <!-- 7 : GroupBoxes côte à côte -->
      <RowDefinition Height="6"/>
      <RowDefinition Height="Auto"/>  <!-- 9 : Boutons bas -->
    </Grid.RowDefinitions>

    <!-- ═══ EN-TÊTE ══════════════════════════════════════════════════════════
         9 colonnes partagées avec le corps via sync ActualWidth :
         [0:30 ✓] [1:4 sep] [2:2* Texte] [3:4 split] [4:* Type]
         [5:4 split] [6:110px Couleur] [7:4 split] [8:* Vue]
         Ligne 0 : titre + bouton tri (⇅/A→Z/Z→A)
         Ligne 1 : bouton filtre multi-sélection
    ═══════════════════════════════════════════════════════════════════════ -->
    <Border Grid.Row="0" Background="#DDE3EA"
            BorderBrush="#8E9BAA" BorderThickness="1,1,1,0">
      <Grid x:Name="headerGrid">
        <Grid.RowDefinitions>
          <RowDefinition Height="24"/>
          <RowDefinition Height="22"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="30"/>    <!-- 0 : ✓ fixe -->
          <ColumnDefinition Width="4"/>     <!-- 1 : sep fixe -->
          <ColumnDefinition Width="2*"/>    <!-- 2 : Texte -->
          <ColumnDefinition Width="4"/>     <!-- 3 : splitter -->
          <ColumnDefinition Width="*"/>     <!-- 4 : Type -->
          <ColumnDefinition Width="4"/>     <!-- 5 : splitter -->
          <ColumnDefinition Width="110"/>   <!-- 6 : Couleur (fixe) -->
          <ColumnDefinition Width="4"/>     <!-- 7 : splitter -->
          <ColumnDefinition Width="*"/>     <!-- 8 : Vue -->
          <ColumnDefinition Width="4"/>     <!-- 9 : sep fixe avant reset global -->
          <ColumnDefinition Width="28"/>    <!-- 10 : bouton reset global fixe -->
        </Grid.ColumnDefinitions>

        <!-- Séparateur fixe col 1 -->
        <Border Grid.RowSpan="2" Grid.Column="1" Background="#8E9BAA"/>

        <!-- Séparateur fixe col 9 (avant reset global) -->
        <Border Grid.RowSpan="2" Grid.Column="9" Background="#8E9BAA"/>

        <!-- GridSplitters redimensionnables -->
        <GridSplitter Grid.RowSpan="2" Grid.Column="3" Width="4"
                      HorizontalAlignment="Stretch" Background="#8E9BAA"
                      ResizeBehavior="PreviousAndNext" Cursor="SizeWE"/>
        <GridSplitter Grid.RowSpan="2" Grid.Column="5" Width="4"
                      HorizontalAlignment="Stretch" Background="#8E9BAA"
                      ResizeBehavior="PreviousAndNext" Cursor="SizeWE"/>
        <GridSplitter Grid.RowSpan="2" Grid.Column="7" Width="4"
                      HorizontalAlignment="Stretch" Background="#8E9BAA"
                      ResizeBehavior="PreviousAndNext" Cursor="SizeWE"/>

        <!-- Col 0 : ✓ -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="✓" FontWeight="Bold"
                   FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <DockPanel Grid.Row="1" Grid.Column="0">
          <Button DockPanel.Dock="Right" x:Name="btnResetCheck"
                  Width="14" Height="18" FontSize="8" Margin="0,1,1,1"
                  Foreground="#CC2200" FontWeight="Bold"
                  ToolTip="Réinitialiser le filtre cases à cocher">
            <TextBlock Text="▽" Foreground="#666666" FontSize="8"/></Button>
          <Button x:Name="btnFilterCheck"
                  Content="▼" Height="18" FontSize="10" Margin="1,1,0,1"/>
        </DockPanel>

        <!-- Col 10 : Reset global (toutes les 2 lignes) -->
        <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="10"
                x:Name="btnResetAll"
                Height="Auto" Margin="2,2"
                Foreground="#CC2200"
                ToolTip="Réinitialiser TOUS les filtres">
          <StackPanel>
            <TextBlock Text="▽" Foreground="#666666" FontSize="8"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="×" Foreground="#CC2200" FontSize="9" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,-2,0,0"/>
          </StackPanel>
        </Button>

        <!-- Col 2 : Texte -->
        <DockPanel Grid.Row="0" Grid.Column="2" LastChildFill="True">
          <Button DockPanel.Dock="Right" x:Name="btnSortText"
                  Content="⇅" Width="26" FontSize="10" Margin="1"/>
          <TextBlock Text="Texte" FontWeight="Bold"
                     VerticalAlignment="Center" Margin="6,0,2,0"/>
        </DockPanel>
        <DockPanel Grid.Row="1" Grid.Column="2">
          <Button DockPanel.Dock="Right" x:Name="btnResetText"
                  Width="22" Height="18" FontSize="10" Margin="1,1,2,1"
                  Foreground="#CC2200" FontWeight="Bold"
                  ToolTip="Réinitialiser le filtre Texte (afficher tout)">
            <TextBlock Text="▽" Foreground="#666666" FontSize="8"/></Button>
          <Button x:Name="btnFilterText"
                  Content="▼ Texte" Height="18" FontSize="10" Margin="2,1,1,1"/>
        </DockPanel>

        <!-- Col 4 : Type -->
        <DockPanel Grid.Row="0" Grid.Column="4" LastChildFill="True">
          <Button DockPanel.Dock="Right" x:Name="btnSortType"
                  Content="⇅" Width="26" FontSize="10" Margin="1"/>
          <TextBlock Text="Type" FontWeight="Bold"
                     VerticalAlignment="Center" Margin="6,0,2,0"/>
        </DockPanel>
        <DockPanel Grid.Row="1" Grid.Column="4">
          <Button DockPanel.Dock="Right" x:Name="btnResetType"
                  Width="22" Height="18" FontSize="10" Margin="1,1,2,1"
                  Foreground="#CC2200" FontWeight="Bold"
                  ToolTip="Réinitialiser le filtre Type (afficher tout)">
            <TextBlock Text="▽" Foreground="#666666" FontSize="8"/></Button>
          <Button x:Name="btnFilterType"
                  Content="▼ Type" Height="18" FontSize="10" Margin="2,1,1,1"/>
        </DockPanel>

        <!-- Col 6 : Couleur -->
        <DockPanel Grid.Row="0" Grid.Column="6" LastChildFill="True">
          <Button DockPanel.Dock="Right" x:Name="btnSortColor"
                  Content="⇅" Width="26" FontSize="10" Margin="1"/>
          <TextBlock Text="Couleur" FontWeight="Bold"
                     VerticalAlignment="Center" Margin="6,0,2,0"/>
        </DockPanel>
        <DockPanel Grid.Row="1" Grid.Column="6">
          <Button DockPanel.Dock="Right" x:Name="btnResetColor"
                  Width="22" Height="18" FontSize="10" Margin="1,1,2,1"
                  Foreground="#CC2200" FontWeight="Bold"
                  ToolTip="Réinitialiser le filtre Couleur (afficher tout)">
            <TextBlock Text="▽" Foreground="#666666" FontSize="8"/></Button>
          <Button x:Name="btnFilterColor"
                  Content="▼ Couleur" Height="18" FontSize="10" Margin="2,1,1,1"/>
        </DockPanel>

        <!-- Col 8 : Vue -->
        <DockPanel Grid.Row="0" Grid.Column="8" LastChildFill="True">
          <Button DockPanel.Dock="Right" x:Name="btnSortView"
                  Content="⇅" Width="26" FontSize="10" Margin="1"/>
          <TextBlock Text="Vue" FontWeight="Bold"
                     VerticalAlignment="Center" Margin="6,0,2,0"/>
        </DockPanel>
        <DockPanel Grid.Row="1" Grid.Column="8">
          <Button DockPanel.Dock="Right" x:Name="btnResetView"
                  Width="22" Height="18" FontSize="10" Margin="1,1,2,1"
                  Foreground="#CC2200" FontWeight="Bold"
                  ToolTip="Réinitialiser le filtre Vue (afficher tout)">
            <TextBlock Text="▽" Foreground="#666666" FontSize="8"/></Button>
          <Button x:Name="btnFilterView"
                  Content="▼ Vue" Height="18" FontSize="10" Margin="2,1,1,1"/>
        </DockPanel>
      </Grid>
    </Border>

    <!-- ═══ CORPS (StackPanel dans ScrollViewer) ══════════════════════════════
         Lignes pré-construites une fois, réarrangées par filtre/tri sans
         recréer les éléments WPF → performances optimales.
    ═══════════════════════════════════════════════════════════════════════ -->
    <Border Grid.Row="1" BorderBrush="#8E9BAA" BorderThickness="1,0,1,1">
      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="notesPanel"/>
      </ScrollViewer>
    </Border>

    <!-- ═══ Compteur ══════════════════════════════════════════════════════════ -->
    <Border Grid.Row="3" Background="#F0FAF0" BorderBrush="#C8E0C8"
            BorderThickness="1" CornerRadius="3" Padding="8,4">
      <TextBlock x:Name="txtCounter" FontSize="12" FontWeight="SemiBold"
                 Foreground="#2A6A2A" HorizontalAlignment="Center"/>
    </Border>

    <!-- ═══ Boutons sélection ════════════════════════════════════════════════ -->
    <Grid Grid.Row="5">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" x:Name="btnSelectAll"
              Content="Tout sélectionner" Height="26"/>
      <Button Grid.Column="2" x:Name="btnDeselectAll"
              Content="Tout désélectionner" Height="26"/>
      <Button Grid.Column="4" x:Name="btnInvert"
              Content="Inverser" Height="26"/>
    </Grid>

    <!-- ═══ GroupBoxes côte à côte : Sélection | Texte ═══════════════════════ -->
    <Grid Grid.Row="7">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <GroupBox Grid.Column="0" Header="Sélection">
        <Grid Margin="4,4,4,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" x:Name="btnLoadConfig"
                  Content="📂  Charger" Height="26"
                  ToolTip="Charger une configuration de sélection (*.NM-Note-Txt-Sel)"/>
          <Button Grid.Column="2" x:Name="btnSaveConfig"
                  Content="💾  Enregistrer" Height="26"
                  ToolTip="Enregistrer les cases cochées dans un fichier (*.NM-Note-Txt-Sel)"/>
        </Grid>
      </GroupBox>

      <GroupBox Grid.Column="2" Header="Texte">
        <Grid Margin="4,4,4,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" x:Name="btnLoadTerms"
                  Content="📂  Charger" Height="26"
                  ToolTip="Cocher les notes dont le texte figure dans un fichier de termes (*.NM-Note-Txt-Exp)"/>
          <Button Grid.Column="2" x:Name="btnSaveTerms"
                  Content="💾  Enregistrer" Height="26"
                  ToolTip="Enregistrer les textes des notes cochées dans un fichier de termes (*.NM-Note-Txt-Exp)"/>
        </Grid>
      </GroupBox>
    </Grid>

    <!-- ═══ Boutons bas ════════════════════════════════════════════════════════ -->
    <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="btnApply"
              Content="▶  Sélectionner dans Revit" Width="210" Height="32"
              Style="{DynamicResource NMButtonValide}"
              IsDefault="True" Margin="0,0,8,0"/>
      <Button x:Name="btnClose" Content="Fermer" Width="90" Height="32"
              Style="{DynamicResource NMButtonValide}" IsCancel="True"/>
    </StackPanel>

  </Grid>
</Window>
