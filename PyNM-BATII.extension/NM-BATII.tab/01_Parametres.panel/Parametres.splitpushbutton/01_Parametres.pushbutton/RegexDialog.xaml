<?xml version="1.0" encoding="utf-8"?>
<Window
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Éditeur Regex"
  MinWidth="600"
  SizeToContent="Height"
  ResizeMode="CanMinimize"
  WindowStartupLocation="CenterOwner">

  <StackPanel Margin="10">
    <GroupBox Header="Regex" Margin="0,0,0,10">
      <TextBox x:Name="regex_text"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               MinWidth="580"
               MinHeight="200"
               VerticalScrollBarVisibility="Auto"/>
    </GroupBox>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="btnCancel" Content="Annuler"  Width="75" IsCancel="True" Margin="0,0,5,0"/>
      <Button x:Name="btnSave"   Content="Enregistrer" Width="75" IsDefault="True"/>
    </StackPanel>
  </StackPanel>
</Window>
