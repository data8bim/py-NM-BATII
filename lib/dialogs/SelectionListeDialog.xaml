<?xml version="1.0" encoding="utf-8"?>
<!-- Sélecteur générique d'un élément du projet Revit ouvert : gabarit de vue,
     type de vue, schéma de surface. Titre, description, en-têtes de colonnes
     et contenu sont fournis par _open_selection_liste dans script.py. -->
<Window
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Choisir"
  Width="640" Height="520"
  MinWidth="420" MinHeight="320"
  ResizeMode="CanResize"
  WindowStartupLocation="CenterOwner">

  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock x:Name="txtDescription"
               Grid.Row="0" Margin="0,0,0,8"
               FontStyle="Italic" Foreground="Gray" FontSize="11"
               TextWrapping="Wrap"/>

    <!-- Recherche libre sur la 1re colonne : ses valeurs étant toutes
         distinctes (un nom), une liste à cocher n'y aurait aucun intérêt.
         Le tri et les filtres par valeurs sont portés par les EN-TÊTES de
         colonnes (standard NM-BATII, cf. dialogs/filtres_colonnes.py). -->
    <Grid Grid.Row="1" Margin="0,0,0,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <TextBlock x:Name="lblFiltre" Grid.Column="0"
                 VerticalAlignment="Center" Margin="0,0,6,0"/>
      <TextBox x:Name="txtFiltre" Grid.Column="1"
               Padding="3,2" VerticalAlignment="Center"
               ToolTip="Recherche sur le nom (insensible à la casse et aux accents)."/>

      <Button Grid.Column="3" x:Name="btnResetAllFilters"
              Content="Réinitialiser tous les filtres"
              Padding="8,2"
              ToolTip="Vide la recherche et lève tous les filtres de colonnes."/>
    </Grid>

    <CheckBox x:Name="chkCompatibles"
              Grid.Row="2" Margin="0,0,0,8"
              IsChecked="True"
              VerticalContentAlignment="Center"
              ToolTip="Décochez pour lister tous les éléments du projet, y compris ceux d'une autre famille de vues."/>

    <DataGrid x:Name="dgElements"
              Grid.Row="3"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              HeadersVisibility="Column"
              IsReadOnly="True"
              SelectionMode="Single"
              Margin="0,0,0,8">
      <DataGrid.Columns>
        <DataGridTextColumn x:Name="colNom"  Header="Nom"  Binding="{Binding nom}"  Width="*"/>
        <DataGridTextColumn x:Name="colInfo" Header="Type" Binding="{Binding info}" Width="180"/>
      </DataGrid.Columns>
    </DataGrid>

    <!-- Pied de dialogue standard NM-BATII : proportions * | 8 | 130 -->
    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="130"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" x:Name="btnOK" Content="▶  Appliquer"
              IsDefault="True" Style="{DynamicResource NMButtonAppliquer}"/>
      <Button Grid.Column="2" x:Name="btnCancel" Content="Annuler"
              IsCancel="True" VerticalAlignment="Center"
              Style="{DynamicResource NMButtonAnnuler}"/>
    </Grid>
  </Grid>
</Window>
