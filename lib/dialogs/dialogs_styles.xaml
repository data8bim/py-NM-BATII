<!-- Bouton Appliquer (pied de dialogue) -->
<!-- Aplat DodgerBlue, texte blanc, SANS bordure : reprend a l'identique le
	 bouton de AlertWindow.xaml (design valide par les utilisateurs).
	 Au survol le fond fonce (#1C86EE) : le bouton est mis en avant, il ne
	 s'estompe pas comme l'ancien NMDialogButton qui jouait sur l'Opacity.
	 Meme hauteur (40) que NMButtonAnnuler. -->
	<Style x:Key="NMButtonAppliquer" TargetType="Button">
		<Setter Property="FontFamily" Value="Segoe UI"/>
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Foreground" Value="White"/>
		<Setter Property="Background" Value="#1E90FF"/>      <!-- DodgerBlue plein -->
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Height" Value="40"/>
		<Setter Property="Padding" Value="10,0"/>
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="SnapsToDevicePixels" Value="True"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border x:Name="border"
							Background="{TemplateBinding Background}"
							CornerRadius="4">
						<ContentPresenter
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Margin="{TemplateBinding Padding}"
							RecognizesAccessKey="True"/>
					</Border>
					<ControlTemplate.Triggers>
						<!-- Survol : le fond fonce (mise en avant) -->
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="border" Property="Background" Value="#1C86EE"/>
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="border" Property="Background" Value="#1565C0"/>
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="border" Property="Background" Value="#BBBBBB"/>
							<Setter Property="Foreground" Value="#EEEEEE"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>




<!-- Bouton Annuler / sortie (pied de dialogue) -->
<!-- Aplat gris, texte blanc, SANS bordure : meme construction que
	 NMButtonAppliquer, seule la teinte change. Meme hauteur (40) : le bouton
	 de sortie se distingue par sa couleur, pas par sa taille. -->
	<Style x:Key="NMButtonAnnuler" TargetType="Button">
		<Setter Property="FontFamily" Value="Segoe UI"/>
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Foreground" Value="White"/>
		<Setter Property="Background" Value="#8A8A8A"/>      <!-- Gris plein -->
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Height" Value="40"/>
		<Setter Property="Padding" Value="10,0"/>
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="SnapsToDevicePixels" Value="True"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border x:Name="border"
							Background="{TemplateBinding Background}"
							CornerRadius="4">
						<ContentPresenter
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Margin="{TemplateBinding Padding}"
							RecognizesAccessKey="True"/>
					</Border>
					<ControlTemplate.Triggers>
						<!-- Survol : le fond fonce (mise en avant) -->
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="border" Property="Background" Value="#6E6E6E"/>
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="border" Property="Background" Value="#565656"/>
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="border" Property="Background" Value="#BBBBBB"/>
							<Setter Property="Foreground" Value="#EEEEEE"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>




<!-- Bouton Secondaire / preparation (pied de dialogue) -->
<!-- Pour les actions qui ne valident ni ne ferment le dialogue, mais qui
	 preparent l'application : "⊕ Selectionner" des fenetres MAPP par
	 selection, par exemple. Meme construction que les deux autres (aplat,
	 texte blanc, sans bordure, hauteur 40) : seule la teinte change, un bleu
	 plus clair qui reste dans la famille "action" sans concurrencer
	 NMButtonAppliquer. -->
	<Style x:Key="NMButtonSecondaire" TargetType="Button">
		<Setter Property="FontFamily" Value="Segoe UI"/>
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Foreground" Value="White"/>
		<Setter Property="Background" Value="#6CB2EE"/>     <!-- Bleu plus clair que DodgerBlue -->
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Height" Value="40"/>
		<Setter Property="Padding" Value="10,0"/>
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="SnapsToDevicePixels" Value="True"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border x:Name="border"
							Background="{TemplateBinding Background}"
							CornerRadius="4">
						<ContentPresenter
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Margin="{TemplateBinding Padding}"
							RecognizesAccessKey="True"/>
					</Border>
					<ControlTemplate.Triggers>
						<!-- Survol : le fond fonce (mise en avant) -->
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="border" Property="Background" Value="#4E9FE3"/>
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="border" Property="Background" Value="#3D87C4"/>
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="border" Property="Background" Value="#BBBBBB"/>
							<Setter Property="Foreground" Value="#EEEEEE"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>




<!-- CheckBox ************************************************************************************************************************* -->
<!-- CheckBox Standard -->
	<Style x:Key="NMCheckBoxStandard" TargetType="CheckBox">
		<Setter Property="Foreground" Value="#333333"/>
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="Margin" Value="5"/>
		<Setter Property="Padding" Value="4,2"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="CheckBox">
					<StackPanel Orientation="Horizontal">
						<Border x:Name="CheckBorder"
								Width="18" Height="18"
								CornerRadius="3"
								Background="White"
								BorderThickness="1"
								BorderBrush="#FFAAAAAA"
								Margin="0,0,6,0"
								VerticalAlignment="Center">
							<Path x:Name="CheckMark"
								Data="M0,4 L2,6 L6,2"
								Stretch="Uniform"
								StrokeThickness="2"
								Stroke="Transparent"
								SnapsToDevicePixels="True"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"/>
						</Border>
						<ContentPresenter VerticalAlignment="Center"
										RecognizesAccessKey="True"/>
					</StackPanel>

					<!-- Triggers pour l'état et le survol -->
					<ControlTemplate.Triggers>
						<!-- Coché -->
						<Trigger Property="IsChecked" Value="True">
							<!-- <Setter TargetName="CheckBorder" Property="Background" Value="#FF007ACC"/> -->
							<Setter TargetName="CheckMark" Property="Stroke" Value="#FF333333"/>
						</Trigger>

						<!-- Survol -->
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="CheckBorder" Property="BorderBrush" Value="DodgerBlue"/>
							<Setter TargetName="CheckBorder" Property="Background" Value="#FFF0F8FF"/>
							<Setter TargetName="CheckMark" Property="Stroke" Value="DodgerBlue"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>




<!-- ComboBox ************************************************************************************************************************* -->
<!-- ComboBox Standard -->
    <Style x:Key="NMComboBoxStandard" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="5"/>
    </Style>



<!-- ComboBox Edité-->
	<Style x:Key="NMComboBoxStandard_v2" TargetType="ComboBox">
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="Foreground" Value="#333333"/>
		<Setter Property="Background" Value="#FFF9F9F9"/>
		<Setter Property="BorderBrush" Value="#FFAAAAAA"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="Padding" Value="6,4"/>
		<Setter Property="Margin" Value="5"/>
		<Setter Property="SnapsToDevicePixels" Value="True"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ComboBox">
					<Grid>
						<Border x:Name="Bd"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="4">
							<DockPanel>
								<ContentPresenter Margin="4,2,24,2"
												  VerticalAlignment="Center"
												  HorizontalAlignment="Left"
												  Content="{TemplateBinding SelectionBoxItem}"
												  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
												  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
								<ToggleButton DockPanel.Dock="Right"
											  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
											  Focusable="False"
											  ClickMode="Press"
											  Background="Transparent"
											  BorderThickness="0">
									<Path Data="M 0 0 L 4 4 L 8 0 Z"
										  Fill="#666"
										  HorizontalAlignment="Center"
										  VerticalAlignment="Center"
										  Margin="0,0,6,0"/>
								</ToggleButton>
							</DockPanel>
						</Border>
						<Popup x:Name="Popup"
							   Placement="Bottom"
							   IsOpen="{TemplateBinding IsDropDownOpen}"
							   AllowsTransparency="True"
							   Focusable="False"
							   PopupAnimation="Slide">
							<Border Background="White"
									BorderBrush="#FFAAAAAA"
									BorderThickness="1"
									CornerRadius="4"
									Margin="0,2,0,0">
								<ScrollViewer>
									<StackPanel IsItemsHost="True"
												KeyboardNavigation.DirectionalNavigation="Contained"/>
								</ScrollViewer>
							</Border>
						</Popup>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="BorderBrush" Value="DodgerBlue"/>
							<Setter TargetName="Bd" Property="Background" Value="#FFE0F0FF"/>
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="Bd" Property="Background" Value="#FFEFEFEF"/>
							<Setter TargetName="Bd" Property="BorderBrush" Value="#FFCCCCCC"/>
							<Setter Property="Foreground" Value="#FF888888"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	



<!-- ListBox ************************************************************************************************************************* -->
<!-- ListBox Standard -->
    <Style x:Key="NMListBoxStandard" TargetType="ListBox">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="5"/>
    </Style>







	
</ResourceDictionary>