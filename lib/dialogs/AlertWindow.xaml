<?xml version="1.0" encoding="utf-8"?>
<!--
  AlertWindow.xaml — Boîte de message générique NM-BATII (styles inline).
  Utilisation via show_alert() dans dialogs_styles_loader.py :
      from dialogs.dialogs_styles_loader import load, show_alert
      show_alert(u"Titre", u"Message à afficher.")
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Information"
        SizeToContent="WidthAndHeight"
        MinWidth="380"
        MaxWidth="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="13">

  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            BorderBrush="DodgerBlue"
            BorderThickness="1"
            CornerRadius="4"
            Padding="14,12">
      <TextBlock x:Name="txtMessage"
                 TextWrapping="Wrap"
                 FontSize="13"
                 Foreground="#333333"
                 TextAlignment="Left"
                 VerticalAlignment="Center"/>
    </Border>

    <Button x:Name="btnClose"
            Grid.Row="2"
            Content="Fermer"
            Height="30"
            HorizontalAlignment="Stretch"
            IsDefault="True"
            IsCancel="True"
            Background="DodgerBlue"
            Foreground="White"
            BorderThickness="0"
            FontWeight="SemiBold"
            Cursor="Hand">
      <Button.Template>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd"
                  Background="{TemplateBinding Background}"
                  CornerRadius="4">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#1C86EE"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#1565C0"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Button.Template>
    </Button>

  </Grid>
</Window>
