<?xml version="1.0" encoding="utf-8"?>
<!--
  AlertWindow.xaml — Boîte de message générique NM-BATII (styles inline).
  Utilisation via show_alert() dans dialogs_styles_loader.py :
      from dialogs.dialogs_styles_loader import load, show_alert
      show_alert(u"Titre", u"Message à afficher.")
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Information"
        SizeToContent="WidthAndHeight"
        MinWidth="380"
        MaxWidth="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="13">

  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            BorderBrush="DodgerBlue"
            BorderThickness="1"
            CornerRadius="4"
            Padding="14,12">
      <TextBlock x:Name="txtMessage"
                 TextWrapping="Wrap"
                 FontSize="13"
                 Foreground="#333333"
                 TextAlignment="Left"
                 VerticalAlignment="Center"/>
    </Border>

    <!-- Fenetre a bouton unique : "Fermer" prend le style Appliquer sur toute
         la largeur. Le template inline a ete retire au profit du style
         partage NMButtonAppliquer (meme aplat DodgerBlue, meme survol) : une
         retouche de teinte dans dialogs_styles.xaml s'appliquera aussi ici.
         DynamicResource : si la feuille n'est pas chargee, le bouton retombe
         sur le rendu WPF par defaut au lieu de faire echouer le parse. -->
    <Button x:Name="btnClose"
            Grid.Row="2"
            Content="Fermer"
            HorizontalAlignment="Stretch"
            IsDefault="True"
            IsCancel="True"
            Style="{DynamicResource NMButtonAppliquer}"/>

  </Grid>
</Window>
