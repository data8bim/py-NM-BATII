<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sélectionner les pièces"
        Width="640" Height="640"
        MinWidth="480" MinHeight="420"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">

  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>  <!-- 0 : En-têtes colonnes -->
      <RowDefinition Height="Auto"/>  <!-- 1 : Filtres / tri -->
      <RowDefinition Height="4"/>
      <RowDefinition Height="*"/>     <!-- 3 : Liste des pièces -->
      <RowDefinition Height="8"/>
      <RowDefinition Height="Auto"/>  <!-- 5 : Tout / Rien / Inverser -->
      <RowDefinition Height="8"/>
      <RowDefinition Height="Auto"/>  <!-- 7 : OK / Annuler -->
    </Grid.RowDefinitions>

    <!-- ═══ En-têtes colonnes ════════════════════════════════════════════════ -->
    <Border Grid.Row="0"
            Background="#F4F4F4" BorderBrush="LightGray"
            BorderThickness="1" CornerRadius="3" Padding="6,5">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="30"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="1" Text="Niveau" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0"/>
        <TextBlock Grid.Column="2" Text="Numéro" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0"/>
        <TextBlock Grid.Column="3" Text="Nom"    FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0"/>
      </Grid>
    </Border>

    <!-- ═══ Filtres et tri ═══════════════════════════════════════════════════ -->
    <Grid Grid.Row="1" Margin="0,4,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="30"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="110"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="1">
        <Button x:Name="btnSortNiveau" DockPanel.Dock="Right"
                Content="⇅" Width="28" Margin="3,0,0,0"
                ToolTip="Trier par niveau (⇅ / A→Z / Z→A)"/>
        <TextBox x:Name="searchNiveau" Height="24" VerticalContentAlignment="Center"
                 ToolTip="Filtrer les pièces dont le niveau contient ce texte"/>
      </DockPanel>

      <DockPanel Grid.Column="2">
        <Button x:Name="btnSortNumero" DockPanel.Dock="Right"
                Content="⇅" Width="28" Margin="3,0,0,0"
                ToolTip="Trier par numéro (⇅ / A→Z / Z→A)"/>
        <TextBox x:Name="searchNumero" Height="24" VerticalContentAlignment="Center"
                 Margin="4,0,0,0"
                 ToolTip="Filtrer les pièces dont le numéro contient ce texte"/>
      </DockPanel>

      <DockPanel Grid.Column="3">
        <Button x:Name="btnSortNom" DockPanel.Dock="Right"
                Content="⇅" Width="28" Margin="3,0,0,0"
                ToolTip="Trier par nom (⇅ / A→Z / Z→A)"/>
        <TextBox x:Name="searchNom" Height="24" VerticalContentAlignment="Center"
                 Margin="4,0,0,0"
                 ToolTip="Filtrer les pièces dont le nom contient ce texte"/>
      </DockPanel>
    </Grid>

    <!-- ═══ Liste des pièces ═════════════════════════════════════════════════ -->
    <Border Grid.Row="3"
            BorderThickness="1" BorderBrush="LightGray">
      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="roomListPanel"/>
      </ScrollViewer>
    </Border>

    <!-- ═══ Tout / Rien / Inverser ═══════════════════════════════════════════ -->
    <Grid Grid.Row="5">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" x:Name="btnSelectAll"
              Content="Tout sélectionner"
              ToolTip="Sélectionner toutes les pièces visibles (non filtrées)"/>
      <Button Grid.Column="2" x:Name="btnDeselectAll"
              Content="Tout désélectionner"
              ToolTip="Désélectionner toutes les pièces visibles"/>
      <Button Grid.Column="4" x:Name="btnInvert"
              Content="Inverser"
              ToolTip="Inverser la sélection des pièces visibles"/>
    </Grid>

    <!-- ═══ OK / Annuler ═════════════════════════════════════════════════════ -->
    <Grid Grid.Row="7">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="130"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" x:Name="btnOk" Content="▶  Appliquer"
              Style="{DynamicResource NMButtonAppliquer}" IsDefault="True"/>
      <Button Grid.Column="2" x:Name="btnCancel" Content="Annuler"
              Style="{DynamicResource NMButtonAnnuler}" IsCancel="True"/>
    </Grid>

  </Grid>
</Window>
