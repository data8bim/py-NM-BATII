<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sélectionner les niveaux"
        Width="380" Height="520"
        MinWidth="300" MinHeight="360"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">

  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>  <!-- 0 Recherche label -->
      <RowDefinition Height="Auto"/>  <!-- 1 TextBox recherche -->
      <RowDefinition Height="Auto"/>  <!-- 2 Tout / Rien / Inverser -->
      <RowDefinition Height="*"/>     <!-- 3 Liste des niveaux -->
      <RowDefinition Height="Auto"/>  <!-- 4 OK / Annuler -->
    </Grid.RowDefinitions>

    <!-- Recherche ─────────────────────────────────────────────────────────── -->
    <TextBlock Grid.Row="0" Text="Rechercher :" Margin="0,0,0,3"/>
    <TextBox   Grid.Row="1" x:Name="searchBox"
               Height="26" Margin="0,0,0,8"
               VerticalContentAlignment="Center"/>

    <!-- Tout / Rien / Inverser ───────────────────────────────────────────── -->
    <Grid Grid.Row="2" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" x:Name="btnSelectAll"
              Content="Tout sélectionner"
              ToolTip="Sélectionner tous les niveaux visibles"/>
      <Button Grid.Column="2" x:Name="btnDeselectAll"
              Content="Tout désélectionner"
              ToolTip="Désélectionner tous les niveaux visibles"/>
      <Button Grid.Column="4" x:Name="btnInvert"
              Content="Inverser"
              ToolTip="Inverser la sélection des niveaux visibles"/>
    </Grid>

    <!-- Liste des niveaux ────────────────────────────────────────────────── -->
    <Border Grid.Row="3"
            BorderThickness="1" BorderBrush="LightGray"
            Margin="0,0,0,8">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="levelListPanel" Margin="6,4"/>
      </ScrollViewer>
    </Border>

    <!-- OK / Annuler ─────────────────────────────────────────────────────── -->
    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="130"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" x:Name="btnOk" Content="▶  Appliquer"
              Style="{DynamicResource NMButtonAppliquer}" IsDefault="True"/>
      <Button Grid.Column="2" x:Name="btnCancel" Content="Annuler"
              Style="{DynamicResource NMButtonAnnuler}" IsCancel="True"/>
    </Grid>

  </Grid>
</Window>
