<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NM-BATII — Contraintes de hauteur des pièces"
        Width="600" Height="560"
        MinWidth="520" MinHeight="480"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <Style TargetType="TextBlock"   BasedOn="{StaticResource NMTextBlockStandard}"/>
    <Style TargetType="TextBox"     BasedOn="{StaticResource NMTextBoxStandard}"/>
    <Style TargetType="Button"      BasedOn="{StaticResource NMButtonStandard}"/>
    <Style TargetType="CheckBox"    BasedOn="{StaticResource NMCheckBoxStandard}"/>
    <!-- Police des options de "Portée du traitement", reprise à l'identique
         pour les champs de "Contraintes de hauteur des pièces" (homogénéité). -->
    <Style TargetType="RadioButton">
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize"   Value="13"/>
    </Style>
  </Window.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>  <!-- 0 : Contraintes de hauteur -->
      <RowDefinition Height="10"/>
      <RowDefinition Height="Auto"/>  <!-- 2 : Portée du traitement -->
      <RowDefinition Height="*"/>     <!-- 3 : espace -->
      <RowDefinition Height="Auto"/>  <!-- 4 : Boutons -->
    </Grid.RowDefinitions>

    <!-- ═══ Contraintes de hauteur ═══════════════════════════════════════════ -->
    <GroupBox Grid.Row="0" Header="Contraintes de hauteur des pièces">
      <Grid Margin="4,6,4,6">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="8"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="8"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="10"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="120"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   FontFamily="Segoe UI" FontSize="13" Foreground="Black"
                   Text="Limite supérieure : nombre de niveaux au-dessus"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtNbNiveaux"
                 Style="{x:Null}"
                 Height="26" VerticalContentAlignment="Center"
                 TextAlignment="Right"
                 Padding="4,2" BorderThickness="1" BorderBrush="#FFAAAAAA" Background="White"
                 FontFamily="Segoe UI" FontSize="13"
                 ToolTip="Nombre entier positif : 1 = niveau immédiatement supérieur, 2 = deux niveaux au-dessus, etc."/>

        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   FontFamily="Segoe UI" FontSize="13" Foreground="Black"
                   Text="Décalage limite (unité du projet)"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtDecalageLimite"
                 Style="{x:Null}"
                 Height="26" VerticalContentAlignment="Center"
                 TextAlignment="Right"
                 Padding="4,2" BorderThickness="1" BorderBrush="#FFAAAAAA" Background="White"
                 FontFamily="Segoe UI" FontSize="13"/>

        <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   FontFamily="Segoe UI" FontSize="13" Foreground="Black"
                   Text="Décalage inférieur (unité du projet)"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtDecalageInferieur"
                 Style="{x:Null}"
                 Height="26" VerticalContentAlignment="Center"
                 TextAlignment="Right"
                 Padding="4,2" BorderThickness="1" BorderBrush="#FFAAAAAA" Background="White"
                 FontFamily="Segoe UI" FontSize="13"/>

        <Button Grid.Row="6" Grid.Column="1" x:Name="btnDefaults"
                Content="Valeurs par défaut" Height="26"
                ToolTip="Rétablit : 1 niveau, décalage limite 0, décalage inférieur 0"/>
      </Grid>
    </GroupBox>

    <!-- ═══ Portée du traitement ══════════════════════════════════════════════ -->
    <GroupBox Grid.Row="2" Header="Portée du traitement">
      <StackPanel Margin="4,4,4,6">

        <RadioButton x:Name="rbToutes" GroupName="portee" Margin="0,5"
                     Content="Toutes les pièces"/>

        <StackPanel Orientation="Horizontal" Margin="0,5">
          <RadioButton x:Name="rbNiveaux" GroupName="portee" VerticalAlignment="Center"
                       Content="Pièces des niveaux :"/>
          <Button x:Name="btnNiveaux" Content="Niveaux..." Margin="8,0,0,0"
                  Padding="8,2" Width="90"/>
          <TextBlock x:Name="txtNiveauxCount" Margin="8,0,0,0" VerticalAlignment="Center"
                     FontSize="12" Text="(0 niveau sélectionné)"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,5">
          <RadioButton x:Name="rbSelection" GroupName="portee" VerticalAlignment="Center"
                       Content="Pièces sélectionnées :"/>
          <Button x:Name="btnSelection" Content="Choisir..." Margin="8,0,0,0"
                  Padding="8,2" Width="90"/>
          <TextBlock x:Name="txtSelectionCount" Margin="8,0,0,0" VerticalAlignment="Center"
                     FontSize="12" Text="(0 pièce sélectionnée)"/>
        </StackPanel>

        <RadioButton x:Name="rbVueActive" GroupName="portee" Margin="0,5"
                     IsChecked="True" Content="Pièces de la vue active"/>

        <StackPanel Orientation="Horizontal" Margin="0,5">
          <RadioButton x:Name="rbVueSelection" GroupName="portee" VerticalAlignment="Center"
                       Content="Pièces sélectionnées dans la vue active :"/>
          <Button x:Name="btnVueSelection" Content="Sélectionner" Margin="8,0,0,0"
                  Padding="8,2" Width="90"/>
          <TextBlock x:Name="txtVueSelectionCount" Margin="8,0,0,0" VerticalAlignment="Center"
                     FontSize="12" Text="(0 pièce sélectionnée)"/>
        </StackPanel>

      </StackPanel>
    </GroupBox>

    <!-- ═══ Boutons d'action ══════════════════════════════════════════════════ -->
    <Grid Grid.Row="4">
      <!-- Pied de dialogue standard NM-BATII : proportions * | 8 | 130.
           "Fermer" et non "Annuler" : Appliquer ne ferme pas la fenetre, les
           contraintes sont deja ecrites quand on sort. -->
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="130"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" x:Name="btnApply"
              Content="▶  Appliquer"
              Style="{DynamicResource NMButtonAppliquer}"
              IsDefault="True"/>
      <Button Grid.Column="2" x:Name="btnClose"
              Content="Fermer"
              Style="{DynamicResource NMButtonAnnuler}"
              IsCancel="True"/>
    </Grid>
  </Grid>
</Window>
