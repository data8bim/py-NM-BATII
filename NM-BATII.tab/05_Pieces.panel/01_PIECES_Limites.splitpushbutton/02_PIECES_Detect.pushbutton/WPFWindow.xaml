<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NM-BATII — Détection de Pièces depuis DWG"
        Width="540" Height="660"
        MinWidth="440" MinHeight="520"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ═══ Sélection DWG ═══════════════════════════════════════════════════ -->
    <GroupBox Grid.Row="0" Header="Fichier DWG à analyser">
      <StackPanel Margin="4,4,4,6">
        <ComboBox x:Name="cmb_dwg" Height="26"/>
        <TextBlock x:Name="lbl_aucun_dwg"
                   Text="Aucun DWG importé ou lié dans la vue active."
                   Foreground="OrangeRed" FontStyle="Italic"
                   Visibility="Collapsed" Margin="0,4,0,0"/>
      </StackPanel>
    </GroupBox>

    <!-- ═══ Paramètres de détection ══════════════════════════════════════════ -->
    <GroupBox Grid.Row="2" Header="Paramètres de détection">
      <Grid Margin="4,4,4,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>  <!-- Row 0 : sélecteur de préset -->
          <RowDefinition Height="8"/>     <!-- Row 1 : séparateur -->
          <RowDefinition Height="Auto"/>  <!-- Row 2 : résolution + dilatation -->
          <RowDefinition Height="6"/>
          <RowDefinition Height="Auto"/>  <!-- Row 4 : aire_min + simplifier -->
          <RowDefinition Height="6"/>
          <RowDefinition Height="Auto"/>  <!-- Row 6 : marge + grille_max -->
        </Grid.RowDefinitions>

        <!-- ── Sélecteur de niveau de qualité ─────────────────────────────── -->
        <!-- Les réglages sont stockés dans config.json → "detect_pieces_dwg" → "presets_qualite". -->
        <!-- Éditer ce fichier pour ajouter de nouveaux niveaux de qualité.    -->
        <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0">
          <TextBlock Text="Niveau de qualité de détection" FontSize="11" Foreground="#555"/>
          <!--
            PopupAnimation="None" sur le Popup interne du ComboBox supprime l'animation
            WPF de fermeture du dropdown (~150 ms). Cela rend la mise à jour des champs
            perceptible immédiatement après le clic, sans délai visuel.
          -->
          <ComboBox x:Name="cmb_preset" Height="26" Margin="0,2,0,0"
                    ToolTip="Sélectionner un niveau prédéfini (config.json › detect_pieces_dwg › presets_qualite).&#x0a;Les valeurs ci-dessous sont mises à jour automatiquement.&#x0a;Vous pouvez ajouter vos propres niveaux en éditant config.json manuellement.">
            <ComboBox.Resources>
              <!-- Désactive l'animation slide/fade du popup de liste déroulante. -->
              <Style TargetType="{x:Type Popup}">
                <Setter Property="PopupAnimation" Value="None"/>
              </Style>
            </ComboBox.Resources>
          </ComboBox>
        </StackPanel>

        <!-- ── Paramètres numériques ────────────────────────────────────────── -->
        <StackPanel Grid.Column="0" Grid.Row="2">
          <TextBlock Text="Résolution (m/pixel)" FontSize="11" Foreground="#555"/>
          <TextBox x:Name="txt_resolution" Height="24" Margin="0,2,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Grid.Row="2">
          <TextBlock Text="Dilatation (pixels)" FontSize="11" Foreground="#555"/>
          <TextBox x:Name="txt_dilatation" Height="24" Margin="0,2,0,0"/>
        </StackPanel>

        <StackPanel Grid.Column="0" Grid.Row="4">
          <TextBlock Text="Aire min pièce (m²)" FontSize="11" Foreground="#555"/>
          <TextBox x:Name="txt_aire_min" Height="24" Margin="0,2,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Grid.Row="4">
          <TextBlock Text="Tolérance simplif. (m)" FontSize="11" Foreground="#555"/>
          <TextBox x:Name="txt_simplifier" Height="24" Margin="0,2,0,0"/>
        </StackPanel>

        <StackPanel Grid.Column="0" Grid.Row="6">
          <TextBlock Text="Marge DWG (m)" FontSize="11" Foreground="#555"/>
          <TextBox x:Name="txt_marge" Height="24" Margin="0,2,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Grid.Row="6">
          <TextBlock Text="Grille max (pixels)" FontSize="11" Foreground="#555"/>
          <TextBox x:Name="txt_grille_max" Height="24" Margin="0,2,0,0"/>
        </StackPanel>
      </Grid>
    </GroupBox>

    <!-- ═══ Filtrage des calques ══════════════════════════════════════════════ -->
    <!-- Seuls les calques VISIBLES dans la vue active sont traités.           -->
    <!-- Les calques dont le nom contient un mot-clé ci-dessous sont ignorés. -->
    <GroupBox Grid.Row="4" Header="Calques DWG ignorés — Mots-clés EXCLURE (un par ligne)">
      <DockPanel Margin="4,4,4,6">
        <TextBlock DockPanel.Dock="Top"
                   Text="Calques visibles mais à exclure du traitement (sanitaires, mobilier, cotation…)"
                   FontSize="10" Foreground="#888" Margin="0,0,0,4"/>
        <TextBox x:Name="txt_exclure"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="11"/>
      </DockPanel>
    </GroupBox>

    <!-- ═══ Boutons d'action ══════════════════════════════════════════════════ -->
	<!-- ═══ Configuration + Boutons d'action en bas ══════════════════════════ -->
	<Grid Grid.Row="6">
	  <Grid.RowDefinitions>
		<RowDefinition Height="Auto"/>  <!-- GroupBox Configuration -->
		<RowDefinition Height="6"/>
		<RowDefinition Height="Auto"/>  <!-- Ligne des 3 boutons -->
	  </Grid.RowDefinitions>

	  <!-- GroupBox Configuration en bas -->
	  <GroupBox Grid.Row="0" Header="Configuration spécifique">
		<Grid Margin="4,4,4,6">
		  <Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="4"/>
			<ColumnDefinition Width="*"/>
		  </Grid.ColumnDefinitions>

		  <Button Grid.Column="0" x:Name="btn_charger"
				  Content="📂  Charger" Height="26"
				  ToolTip="Charger une configuration .NM-RoomLim"/>

		  <Button Grid.Column="2" x:Name="btn_enregistrer"
				  Content="💾  Enregistrer" Height="26"
				  ToolTip="Enregistrer la configuration .NM-RoomLim"/>
		</Grid>
	  </GroupBox>

	  <!-- Ligne des 3 boutons alignés à droite -->
	  <Grid Grid.Row="2">
		<Grid.ColumnDefinitions>
		  <ColumnDefinition Width="*"/>       <!-- pousse à droite -->
		  <ColumnDefinition Width="Auto"/>     <!-- Une piece (clic) -->
		  <ColumnDefinition Width="6"/>
		  <ColumnDefinition Width="Auto"/>     <!-- Toutes les pieces -->
		  <ColumnDefinition Width="6"/>
		  <ColumnDefinition Width="Auto"/>     <!-- Fermer -->
		</Grid.ColumnDefinitions>

		<Button Grid.Column="1" x:Name="btn_une_piece"
				Content="Une piece (clic)" Height="32"
				Style="{DynamicResource NMButtonValide}"
				ToolTip="Cliquer dans une pièce pour la détecter seule"/>

		<Button Grid.Column="3" x:Name="btn_toutes"
				Content="Toutes les pieces" Height="32"
				Style="{DynamicResource NMButtonValide}"
				ToolTip="Détecter et créer toutes les pièces fermées du DWG"/>

		<Button Grid.Column="5" x:Name="btn_fermer"
				Content="Fermer" Height="32"
				Style="{DynamicResource NMButtonValide}"
				IsCancel="True"
				ToolTip="Fermer la palette"/>
	  </Grid>
	</Grid>
  </Grid>
</Window>
