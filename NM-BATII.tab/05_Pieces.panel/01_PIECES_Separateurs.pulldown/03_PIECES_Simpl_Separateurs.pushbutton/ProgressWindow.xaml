<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NM-BATII — Traitement en cours..."
        Width="460" SizeToContent="Height" MinHeight="160"
        MinWidth="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

  <Border BorderBrush="DodgerBlue" BorderThickness="1" CornerRadius="3" Margin="8">
    <Grid Margin="14,10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>   <!-- txtStatus    -->
        <RowDefinition Height="8"/>
        <RowDefinition Height="Auto"/>   <!-- progressBar  -->
        <RowDefinition Height="4"/>
        <RowDefinition Height="Auto"/>   <!-- txtCurrent   -->
        <RowDefinition Height="4"/>
        <RowDefinition Height="Auto"/>   <!-- txtLog       -->
      </Grid.RowDefinitions>

      <!-- Statut principal (passe / étape) -->
      <TextBlock x:Name="txtStatus"
                 Grid.Row="0"
                 Text="Préparation..."
                 FontSize="13"
                 FontWeight="SemiBold"
                 TextWrapping="Wrap"/>

      <!-- Barre de progression -->
      <ProgressBar x:Name="progressBar"
                   Grid.Row="2"
                   Height="18"
                   Minimum="0" Maximum="100" Value="0"
                   Foreground="DodgerBlue"/>

      <!-- Compteur de la passe précédente -->
      <TextBlock x:Name="txtCurrent"
                 Grid.Row="4"
                 Text=""
                 FontSize="11"
                 Foreground="Gray"
                 HorizontalAlignment="Center"/>

      <!-- Action la plus récente (log en direct) -->
      <TextBlock x:Name="txtLog"
                 Grid.Row="6"
                 Text=""
                 FontSize="10"
                 FontStyle="Italic"
                 Foreground="#999999"
                 TextWrapping="NoWrap"
                 TextTrimming="CharacterEllipsis"/>
    </Grid>
  </Border>
</Window>
