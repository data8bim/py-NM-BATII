<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NM-BATII — Reproduire les étiquettes de pièces entre vues"
        Width="1200" Height="700"
        MinWidth="700" MinHeight="420"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <Style TargetType="TextBlock" BasedOn="{StaticResource NMTextBlockStandard}"/>
    <Style TargetType="Button"    BasedOn="{StaticResource NMButtonStandard}"/>
    <Style TargetType="CheckBox"  BasedOn="{StaticResource NMCheckBoxStandard}">
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </Window.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="10"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ═══ Options ══════════════════════════════════════════════════════ -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                 Text="Cochez les vues sources (contenant déjà des étiquettes de pièces), puis cliquez sur « Sélectionner » (colonne « Vers vues ») pour choisir les vues de destination (même type et même niveau associé, avec option « Même échelle »)."/>
    </Grid>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" x:Name="btnSelectAll"   Content="Tout sélectionner"   Padding="8,2"/>
      <Button Grid.Column="2" x:Name="btnDeselectAll" Content="Tout désélectionner" Padding="8,2"/>
      <Button Grid.Column="4" x:Name="btnInvert"      Content="Inverser"            Padding="8,2"/>
      <Button Grid.Column="6" x:Name="btnResetAllFilters" Content="Réinitialiser tous les filtres" Padding="8,2"/>
      <TextBlock Grid.Column="8" x:Name="txtCount" VerticalAlignment="Center"
                 HorizontalAlignment="Right" FontSize="12" Text="(0 vue sélectionnée comme source)"/>
    </Grid>

    <!-- ═══ Tableau des vues sources ════════════════════════════════════ -->
    <DataGrid x:Name="dataGrid" Grid.Row="4"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              CanUserSortColumns="False"
              SelectionMode="Extended"
              SelectionUnit="FullRow"
              HeadersVisibility="Column"
              GridLinesVisibility="All"
              RowHeaderWidth="0"
              FrozenColumnCount="3"
              HorizontalScrollBarVisibility="Auto"
              VerticalScrollBarVisibility="Auto"
              FontSize="12"/>

    <!-- ═══ Boutons d'action ═══════════════════════════════════════════ -->
    <Grid Grid.Row="6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="130"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" x:Name="btnOK"
              Content="▶  Reproduire"
              Style="{DynamicResource NMButtonAppliquer}"
              IsDefault="True"/>
      <Button Grid.Column="2" x:Name="btnCancel"
              Content="Annuler"
              Style="{DynamicResource NMButtonAnnuler}"
              IsCancel="True"/>
    </Grid>
  </Grid>
</Window>
