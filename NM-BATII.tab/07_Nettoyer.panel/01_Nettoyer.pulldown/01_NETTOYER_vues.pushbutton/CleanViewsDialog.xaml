<?xml version="1.0" encoding="utf-8"?>

<Window
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="Nettoyage des vues"
		SizeToContent="WidthAndHeight"
		MinWidth="500"
		MaxWidth="700"
		MinHeight="400"
		MaxHeight="600"
		ResizeMode="NoResize"
		WindowStartupLocation="CenterScreen">

	<Window.Resources>
		<Style TargetType="Window" BasedOn="{StaticResource NMWindowStandard}" />
		<Style TargetType="TextBlock" BasedOn="{StaticResource NMTextBlockStandard}" />
		<Style TargetType="TextBox" BasedOn="{StaticResource NMTextBoxStandard}" />
		<Style TargetType="Button" BasedOn="{StaticResource NMButtonStandard}" />
		<Style x:Key="NMButtonValideOnly" TargetType="Button" BasedOn="{StaticResource NMButtonValide}" />
		<Style TargetType="ListBox" BasedOn="{StaticResource NMListBoxStandard}" />
		<Style TargetType="CheckBox" BasedOn="{StaticResource NMCheckBoxStandard}" />
	</Window.Resources>

	<Grid Margin="5">
		<!-- Lignes de la grille principale -->
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>  <!-- 0. Sélection des vues -->
			<RowDefinition Height="Auto"/>     <!-- 1. Options -->
			<RowDefinition Height="Auto"/>  <!-- 2 : OK/Annuler -->
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>



		<!-- 0. Sélection des vues -->
		<GroupBox
			Header="Vues à nettoyer"
			Grid.Row="0"
			Grid.Column="0"
			BorderThickness="1"
			BorderBrush="LightGray"
			Padding="0">
			
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>  <!-- filtre -->
					<RowDefinition Height="Auto"/>  <!-- boutons -->
					<RowDefinition Height="*"/>     <!-- liste -->
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<!-- Filtre -->
				<Grid	Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>  <!-- filtre -->
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					
					<TextBlock
						Grid.Row="0" Grid.Column="0"
						Text="Filtre des vues :"
						VerticalAlignment="Center"
						HorizontalAlignment="Right"/>
					<TextBox
						x:Name="txtFilterViews"
						Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
						VerticalAlignment="Center"
						ToolTip="Tapez une partie du nom pour filtrer"/>
				</Grid>

				
				<!-- Boutons de sélection -->				
				<Grid	Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>  <!-- Boutons -->
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<Button x:Name="btnSelectAllViews"   Content="Tout sélectionner" Grid.Row="0" Grid.Column="0"/>
					<Button x:Name="btnDeselectAllViews" Content="Tout désélectionner" Grid.Row="0" Grid.Column="1"/>
					<Button x:Name="btnInvertViews"      Content="Inverser la sélection" Grid.Row="0" Grid.Column="2"/>
					
				</Grid>

				<!-- ListBox -->
				<ListBox
					x:Name="listBoxViews"
					Grid.Row="2" Grid.ColumnSpan="3"
					Height="250"
					BorderThickness="1"
					BorderBrush="LightGray"
					Padding="4"
					SelectionMode="Extended"
					VirtualizingStackPanel.IsVirtualizing="True"
					VirtualizingStackPanel.VirtualizationMode="Standard">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<CheckBox
								Content="{Binding Name}"
								IsChecked="{Binding IsSelected,
											RelativeSource={RelativeSource AncestorType=ListBoxItem},
											Mode=TwoWay}" />
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</Grid>
		</GroupBox>
		
		
		
		<!-- 1. Options -->
		<GroupBox
			Header="Choisissez les actions à effectuer"
			Grid.Row="1"
			Grid.Column="0"
			Margin="0,15,0,10">
			
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="*"/>	<!-- 0.1. Options -->
					<RowDefinition Height="*"/>	<!-- 0.0. Boutons de sélections des options -->
				</Grid.RowDefinitions>
				
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<!-- 0.0. Options -->
				<UniformGrid
					x:Name="panelOptions"
					Grid.Row="0"
					Grid.Column="0"
					Grid.ColumnSpan="2"
					Columns="2"
					Margin="5,0,5,5"/>				

				<!-- 0.1. Boutons de sélections des options -->
				<Button x:Name="btnSelectAllOps"   Content="Tout sélectionner" Grid.Row="1" Grid.Column="0"/>
				<Button x:Name="btnDeselectAllOps" Content="Tout désélectionner" Grid.Row="1" Grid.Column="1"/>

			</Grid>
		</GroupBox>		
		

		<!-- 2. Boutons OK / Annuler -->
		<Grid	Grid.Row="2" Grid.Column="0">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>
			<!-- Pied de dialogue standard NM-BATII : proportions * | 8 | 130 -->
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="8"/>
				<ColumnDefinition Width="130"/>
			</Grid.ColumnDefinitions>

			<Button x:Name="OkButton"     Content="▶  Appliquer" Style="{DynamicResource NMButtonAppliquer}" IsDefault="True" Grid.Row="0" Grid.Column="0"/>
			<Button x:Name="CancelButton" Content="Annuler"      Style="{DynamicResource NMButtonAnnuler}"   IsCancel="True"  Grid.Row="0" Grid.Column="2"/>
			
		</Grid>		

	</Grid>
</Window>
