<?xml version="1.0" encoding="utf-8"?>
<!-- Étiquette posée par la palette « Surfaces », par type de calcul.

     Le mappage est fait PAR TYPE DE CALCUL et non par clé de style : quatre à
     six lignes à tenir à jour au lieu d'une cinquantaine, pour un résultat
     identique — les étiquettes se distinguent par famille réglementaire, pas
     par style.

     Comme l'ordre et les couleurs, ces réglages vivent dans config.json et
     identifient l'étiquette par sa chaîne « Famille : Type », jamais par
     ElementId : un identifiant n'a de sens que dans le document où il a été lu,
     alors que le réglage doit valoir sur tous les projets.

     Pas de binding ni de DataGrid : les lignes sont construites en Python
     (_dialogue_etiquettes dans script.py). Un DataGrid aurait rouvert le piège
     connu de DataGridCheckBoxColumn + ElementStyle, dont le TwoWay ne committe
     plus. -->
<Window
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Étiquettes des surfaces"
  Width="980" Height="520"
  MinWidth="700" MinHeight="360"
  WindowStartupLocation="CenterOwner">

  <Window.Resources>
    <!-- INFOBULLES REPLIÉES, pour toute la fenêtre. Même style que
         StylesOrdreDialog.xaml, et même raison : une chaîne passée à ToolTip
         s'affiche sur UNE seule ligne, aussi longue que le texte. Poser
         MaxWidth ne suffit pas — le ContentPresenter rend la chaîne dans un
         TextBlock qui ne se replie pas ; il faut lui imposer un ContentTemplate
         dont le TextBlock, lui, replie.

         Style IMPLICITE (pas de x:Key) : il vaut aussi pour les infobulles
         créées en Python sur les lignes, qui sont ici les plus longues — les
         noms complets « Famille : Type » dépassent 70 caractères, et le
         message des types de calcul absents du projet en fait le double. -->
    <Style TargetType="ToolTip">
      <Setter Property="MaxWidth" Value="300"/>
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- 0 ce que contient la liste -->
      <RowDefinition Height="Auto"/>   <!-- 1 en-têtes de colonnes -->
      <RowDefinition Height="*"/>      <!-- 2 lignes -->
      <RowDefinition Height="Auto"/>   <!-- 3 pied -->
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               x:Name="txtInfo"
               TextWrapping="Wrap"
               Margin="2,0,2,8"
               Foreground="#555555"/>

    <!-- Largeurs répétées à l'identique sur chaque ligne construite en Python
         (voir _LARGEUR_CALCUL et _LARGEUR_REPERE) : c'est ce qui aligne les
         colonnes sans imbriquer toute la liste dans une seule grille. Les trois
         valeurs doivent bouger ensemble.

         La colonne des étiquettes prend tout le reste : les noms complets
         « Famille : Type » dépassent les 70 caractères, et un nom tronqué en
         milieu de chaîne ne se distingue plus de son voisin. Le type de calcul,
         lui, tient largement en 170 px. -->
    <Grid Grid.Row="1" Margin="7,0,22,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="170"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="110"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Type de calcul" FontWeight="SemiBold"/>
      <TextBlock Grid.Column="1" Text="Étiquette posée" FontWeight="SemiBold"
                 Margin="4,0,0,0"/>
      <TextBlock Grid.Column="2" Text="Ligne de repère" FontWeight="SemiBold"
                 HorizontalAlignment="Center"/>
    </Grid>

    <Border Grid.Row="2"
            BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="3"
            Padding="4">
      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="pnlLignes"/>
      </ScrollViewer>
    </Border>

    <!-- Pied de dialogue standard NM-BATII : proportions * | 8 | 130 -->
    <Grid Grid.Row="3" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="130"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" x:Name="btnOk" Content="▶  Appliquer"
              IsDefault="True" Style="{DynamicResource NMButtonAppliquer}"/>
      <Button Grid.Column="2" x:Name="btnCancel" Content="Annuler"
              IsCancel="True" VerticalAlignment="Center"
              Style="{DynamicResource NMButtonAnnuler}"/>
    </Grid>
  </Grid>
</Window>
