<?xml version="1.0" encoding="utf-8"?>
<Window
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Éditeur Regex"
  MinWidth="600"
  SizeToContent="Height"
  ResizeMode="CanMinimize"
  WindowStartupLocation="CenterOwner">

  <StackPanel Margin="10">
    <GroupBox Header="Regex" Margin="0,0,0,10">
      <TextBox x:Name="regex_text"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               MinWidth="580"
               MinHeight="200"
               VerticalScrollBarVisibility="Auto"/>
    </GroupBox>
    <!-- Pied de dialogue standard NM-BATII : proportions * | 8 | 130.
         Le verbe reste "Enregistrer" : l'action ecrit reellement dans config.json. -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="130"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" x:Name="btnSave" Content="▶  Enregistrer"
              IsDefault="True" Style="{DynamicResource NMButtonAppliquer}"/>
      <Button Grid.Column="2" x:Name="btnCancel" Content="Annuler"
              IsCancel="True" VerticalAlignment="Center"
              Style="{DynamicResource NMButtonAnnuler}"/>
    </Grid>
  </StackPanel>
</Window>
