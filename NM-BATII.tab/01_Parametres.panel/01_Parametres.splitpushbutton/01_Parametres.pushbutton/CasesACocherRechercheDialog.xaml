<?xml version="1.0" encoding="utf-8"?>
<!-- Dialogue de cases à cocher des QUATRE colonnes de « Vues personnalisées » :
     « Familles de vues », « Discipline », « Types niv. par défaut » et
     « Disponibilité ».

     Le champ de recherche est MASQUÉ par défaut et n'est demandé que par la
     colonne « Discipline » (paramètre avec_recherche de
     _open_checklist_dialog) : un référentiel hiérarchique compte des centaines
     de lignes, les trois autres colonnes une poignée.

     L'état coché/décoché et le SURLIGNAGE sont deux choses séparées,
     volontairement : une case cochée doit rester cochée quoi que fasse le
     filtre de recherche ou le défilement. L'état vit donc sur l'objet ligne
     lui-même (INotifyPropertyChanged, voir _CaseRow dans script.py), jamais
     sur IsSelected d'une ListBoxItem — même mécanique que la case à cocher
     de ligne de 08_Modifier > Sélection-Épinglage.

     Ctrl+Clic, Maj+Clic et Ctrl+Maj+Clic construisent le SURLIGNAGE ;
     cocher une case appartenant à ce surlignage applique son nouvel état à
     toute la sélection. Le surlignage est calculé par script.py et non
     laissé à WPF : sur un clic qui atterrit d'abord sur une case à cocher,
     l'ordre dans lequel WPF met à jour la sélection de la ListBoxItem n'est
     pas garanti. SelectionMode="Extended" reste déclaré pour que le rendu
     multi-sélection existe, mais c'est le code qui décide de son contenu.

     Les boutons Tout sélectionner / désélectionner / Inverser agissent sur
     TOUTES les lignes affichées, jamais sur le seul surlignage : ils sont
     là pour traiter l'ensemble d'un coup, le surlignage sert au cochage à
     la souris. Seule la recherche les borne — ce qu'elle masque n'est pas
     touché. -->
<Window
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Configurer"
  Width="440" Height="560"
  MinWidth="360" MinHeight="360"
  ResizeMode="CanResize"
  WindowStartupLocation="CenterOwner">

  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>  <!-- 0 description -->
      <RowDefinition Height="Auto"/>  <!-- 1 recherche -->
      <RowDefinition Height="Auto"/>  <!-- 2 filtre "cochées seulement" -->
      <RowDefinition Height="Auto"/>  <!-- 3 actions de masse -->
      <RowDefinition Height="*"/>     <!-- 4 liste -->
      <RowDefinition Height="Auto"/>  <!-- 5 note -->
      <RowDefinition Height="Auto"/>  <!-- 6 pied -->
    </Grid.RowDefinitions>

    <TextBlock x:Name="txtDescription"
               Grid.Row="0" Margin="0,0,0,8"
               FontStyle="Italic" Foreground="Gray" FontSize="11"
               TextWrapping="Wrap"/>

    <TextBox x:Name="txtRecherche"
             Grid.Row="1" Margin="0,0,0,6"
             Style="{DynamicResource NMTextBoxStandard}"
             ToolTip="Filtre la liste ci-dessous, sur le libellé affiché. Une ligne cochée puis masquée par la recherche reste cochée : la recherche n'affiche qu'un sous-ensemble, elle ne modifie rien."/>

    <!-- Trois colonnes ETOILE, pas un StackPanel a largeurs figees : les
         boutons se partagent exactement la largeur du dialogue et restent
         identiques entre eux quelle que soit la longueur de leur libelle ou
         la taille de la fenetre. Une largeur en dur ne survivait pas au
         redimensionnement et dependait des metriques de police du poste.
         Hauteur explicite : le style partage n'en impose pas, chacun
         prenait sinon celle de son propre contenu. -->
    <!-- Ne montrer que les lignes cochees. Le tri n'est pas une option ici :
         la liste garde son ordre, seules les lignes decochees disparaissent —
         c'est ce qui permet de relire un reglage long (le referentiel des
         disciplines en compte des centaines) sans le parcourir en entier.
         Le filtre n'agit QUE sur l'affichage : une ligne decochee puis
         masquee reste decochee, et reapparait des que la case est levee. -->
    <CheckBox x:Name="chkSeulesCochees"
              Grid.Row="2" Margin="2,0,0,6"
              Content="Afficher uniquement les valeurs sélectionnées"
              ToolTip="Masque les lignes décochées. Se combine à la recherche. N'agit que sur l'affichage : rien n'est modifié, et la liste complète revient dès que la case est décochée."/>

    <Grid Grid.Row="3" Margin="0,0,0,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" x:Name="btnToutSelectionner"
              Content="Tout sélectionner"
              Height="26" MinWidth="0" Padding="4,0"
              Style="{DynamicResource NMButtonStandard}"
              ToolTip="Coche toutes les lignes affichées."/>
      <Button Grid.Column="2" x:Name="btnToutDeselectionner"
              Content="Tout désélectionner"
              Height="26" MinWidth="0" Padding="4,0"
              Style="{DynamicResource NMButtonStandard}"
              ToolTip="Décoche toutes les lignes affichées."/>
      <Button Grid.Column="4" x:Name="btnInverser"
              Content="Inverser"
              Height="26" MinWidth="0" Padding="4,0"
              Style="{DynamicResource NMButtonStandard}"
              ToolTip="Inverse l'état de toutes les lignes affichées : ce qui est coché se décoche, et inversement."/>
    </Grid>

    <Border Grid.Row="4" BorderBrush="#CCCCCC" BorderThickness="1"
            Margin="0,0,0,8">
      <ListBox x:Name="lstCases"
               Style="{DynamicResource NMListBoxStandard}"
               SelectionMode="Extended"
               BorderThickness="0"
               HorizontalContentAlignment="Stretch"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ToolTip="Ctrl+Clic : ajoute ou retire une ligne du surlignage. Maj+Clic : surligne toute la plage depuis la dernière ligne cliquée. Ctrl+Maj+Clic : ajoute la plage au surlignage existant. Cocher une case surlignée applique son état à toute la sélection.">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="IsEnabled" Value="{Binding actif}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <CheckBox IsChecked="{Binding coche, Mode=TwoWay}"
                      ToolTip="{Binding tip}"
                      ToolTipService.ShowOnDisabled="True"
                      Margin="2,3">
              <TextBlock Text="{Binding libelle}" TextWrapping="Wrap"/>
            </CheckBox>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <!-- Message d'avertissement contextuel (masqué par défaut) -->
    <TextBlock x:Name="txtNote"
               Grid.Row="5" Margin="0,0,0,8"
               Visibility="Collapsed"
               Foreground="#B35C00" FontSize="11"
               TextWrapping="Wrap"/>

    <!-- Pied de dialogue standard NM-BATII : proportions * | 8 | 130 -->
    <Grid Grid.Row="6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="130"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" x:Name="btnOK" Content="▶  Appliquer"
              IsDefault="True" Style="{DynamicResource NMButtonAppliquer}"/>
      <Button Grid.Column="2" x:Name="btnCancel" Content="Annuler"
              IsCancel="True" VerticalAlignment="Center"
              Style="{DynamicResource NMButtonAnnuler}"/>
    </Grid>
  </Grid>
</Window>
