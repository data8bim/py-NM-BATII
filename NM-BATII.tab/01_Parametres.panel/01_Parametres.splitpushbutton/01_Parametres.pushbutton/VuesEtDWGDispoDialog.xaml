<?xml version="1.0" encoding="utf-8"?>
<Window
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Disponibilites familles de vues"
  Width="700" Height="400"
  ResizeMode="NoResize"
  WindowStartupLocation="CenterOwner">

  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="Disponibilite des familles de vues dans les scripts :"
               TextWrapping="Wrap"
               Margin="0,0,0,8"/>

    <DataGrid x:Name="dgDispo"
              Grid.Row="1"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              HeadersVisibility="Column"
              SelectionMode="Single"
              Margin="0,0,0,8">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Famille de vue"
                            Binding="{Binding label}"
                            Width="*"
                            IsReadOnly="True"/>
        <!-- "Coupe", "Elevation" et "Vue 3D" ne sont pas prises en charge par
             04_Lier_importer.panel/01_Lier_CAO (create_view_element ne sait
             produire que ViewPlan / ViewDrafting / Legend depuis un niveau) :
             leur case est grisee. Pour les reactiver, retirer les DataTriggers
             ci-dessous ET ajouter les familles dans _VUE_ID_TO_FAMILY du
             script 01_Lier_CAO. -->
        <DataGridCheckBoxColumn Binding="{Binding vues_et_dwg, Mode=TwoWay}"
                                Width="80">
          <DataGridCheckBoxColumn.HeaderTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="Lier CAO" HorizontalAlignment="Center"/>
                <TextBlock Text="&#x2192; Vues" HorizontalAlignment="Center"/>
              </StackPanel>
            </DataTemplate>
          </DataGridCheckBoxColumn.HeaderTemplate>
          <DataGridCheckBoxColumn.ElementStyle>
            <Style TargetType="CheckBox">
              <Setter Property="HorizontalAlignment" Value="Center"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding id}" Value="vue-coupe">
                  <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding id}" Value="vue-elevation">
                  <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding id}" Value="vue-nomenclature">
                  <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding id}" Value="vue-3d">
                  <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DataGridCheckBoxColumn.ElementStyle>
          <DataGridCheckBoxColumn.EditingElementStyle>
            <Style TargetType="CheckBox">
              <Setter Property="HorizontalAlignment" Value="Center"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding id}" Value="vue-coupe">
                  <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding id}" Value="vue-elevation">
                  <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding id}" Value="vue-nomenclature">
                  <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding id}" Value="vue-3d">
                  <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DataGridCheckBoxColumn.EditingElementStyle>
        </DataGridCheckBoxColumn>
        <!-- "Coupe" et "Elevation" ne sont pas prises en charge par
             03_Vues.panel/01_Vues_+ (pas de creation ViewSection) : leur case
             est grisee ici pour ne pas laisser cocher une option sans effet.
             Pour les reactiver plus tard, retirer les DataTriggers ci-dessous
             ET ajouter les familles correspondantes dans _VUE_ID_TO_FAMILY
             du script 01_Vues_+. -->
        <DataGridCheckBoxColumn Binding="{Binding vues_plus, Mode=TwoWay}"
                                Width="70">
          <DataGridCheckBoxColumn.HeaderTemplate>
            <DataTemplate>
              <TextBlock Text="Vues +" HorizontalAlignment="Center"/>
            </DataTemplate>
          </DataGridCheckBoxColumn.HeaderTemplate>
          <DataGridCheckBoxColumn.ElementStyle>
            <Style TargetType="CheckBox">
              <Setter Property="HorizontalAlignment" Value="Center"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding id}" Value="vue-coupe">
                  <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding id}" Value="vue-elevation">
                  <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding id}" Value="vue-nomenclature">
                  <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DataGridCheckBoxColumn.ElementStyle>
          <DataGridCheckBoxColumn.EditingElementStyle>
            <Style TargetType="CheckBox">
              <Setter Property="HorizontalAlignment" Value="Center"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding id}" Value="vue-coupe">
                  <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding id}" Value="vue-elevation">
                  <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding id}" Value="vue-nomenclature">
                  <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DataGridCheckBoxColumn.EditingElementStyle>
        </DataGridCheckBoxColumn>
        <!-- Seule la ligne "Vue 3D" peut être cochée ici (case des autres lignes
             grisée/inactive). Le code des autres lignes est conservé au cas où
             elles devraient être réactivées plus tard : il suffit de retirer le
             DataTrigger ci-dessous. -->
        <DataGridCheckBoxColumn Binding="{Binding pieces_3d, Mode=TwoWay}"
                                Width="80">
          <DataGridCheckBoxColumn.HeaderTemplate>
            <DataTemplate>
              <TextBlock Text="Pi&#232;ces 3D" HorizontalAlignment="Center" TextWrapping="Wrap"/>
            </DataTemplate>
          </DataGridCheckBoxColumn.HeaderTemplate>
          <DataGridCheckBoxColumn.ElementStyle>
            <Style TargetType="CheckBox">
              <Setter Property="HorizontalAlignment" Value="Center"/>
              <Setter Property="IsEnabled" Value="False"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding label}" Value="Vue 3D">
                  <Setter Property="IsEnabled" Value="True"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DataGridCheckBoxColumn.ElementStyle>
          <DataGridCheckBoxColumn.EditingElementStyle>
            <Style TargetType="CheckBox">
              <Setter Property="HorizontalAlignment" Value="Center"/>
              <Setter Property="IsEnabled" Value="False"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding label}" Value="Vue 3D">
                  <Setter Property="IsEnabled" Value="True"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DataGridCheckBoxColumn.EditingElementStyle>
        </DataGridCheckBoxColumn>
      </DataGrid.Columns>
    </DataGrid>

    <!-- Pied de dialogue standard NM-BATII : proportions * | 8 | 130 -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="130"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" x:Name="btnOk" Content="▶  Appliquer"
              IsDefault="True" Style="{DynamicResource NMButtonAppliquer}"/>
      <Button Grid.Column="2" x:Name="btnCancel" Content="Annuler"
              IsCancel="True" VerticalAlignment="Center"
              Style="{DynamicResource NMButtonAnnuler}"/>
    </Grid>
  </Grid>

</Window>
