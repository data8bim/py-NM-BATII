<?xml version="1.0" encoding="utf-8"?>
<Window
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Disponibilites vues personnalisees"
  Width="700" Height="400"
  ResizeMode="NoResize"
  WindowStartupLocation="CenterOwner">

  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="Disponibilite des vues personnalisees dans les scripts :"
               TextWrapping="Wrap"
               Margin="0,0,0,8"/>

    <DataGrid x:Name="dgDispo"
              Grid.Row="1"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              HeadersVisibility="Column"
              SelectionMode="Single"
              Margin="0,0,0,8">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Label"
                            Binding="{Binding label}"
                            Width="*"
                            IsReadOnly="True"/>
        <DataGridCheckBoxColumn Binding="{Binding lier_cao, Mode=TwoWay}"
                                Width="80">
          <DataGridCheckBoxColumn.HeaderTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="Lier CAO" HorizontalAlignment="Center"/>
                <TextBlock Text="&#x2192; Vues" HorizontalAlignment="Center"/>
              </StackPanel>
            </DataTemplate>
          </DataGridCheckBoxColumn.HeaderTemplate>
        </DataGridCheckBoxColumn>
        <DataGridCheckBoxColumn Binding="{Binding vues_plus, Mode=TwoWay}"
                                Width="70">
          <DataGridCheckBoxColumn.HeaderTemplate>
            <DataTemplate>
              <TextBlock Text="Vues +" HorizontalAlignment="Center"/>
            </DataTemplate>
          </DataGridCheckBoxColumn.HeaderTemplate>
        </DataGridCheckBoxColumn>
        <!-- Une seule ligne peut être cochée (voir handler Checked côté code
             qui décoche les autres lignes de cette colonne). -->
        <DataGridCheckBoxColumn Binding="{Binding pieces_3d, Mode=TwoWay}"
                                Width="80">
          <DataGridCheckBoxColumn.HeaderTemplate>
            <DataTemplate>
              <TextBlock Text="Pi&#232;ces 3D" HorizontalAlignment="Center" TextWrapping="Wrap"/>
            </DataTemplate>
          </DataGridCheckBoxColumn.HeaderTemplate>
          <DataGridCheckBoxColumn.ElementStyle>
            <Style TargetType="CheckBox">
              <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>
          </DataGridCheckBoxColumn.ElementStyle>
        </DataGridCheckBoxColumn>
      </DataGrid.Columns>
    </DataGrid>

    <!-- Pied de dialogue standard NM-BATII : proportions * | 8 | 130 -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="130"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" x:Name="btnOk" Content="▶  Appliquer"
              IsDefault="True" Style="{DynamicResource NMButtonAppliquer}"/>
      <Button Grid.Column="2" x:Name="btnCancel" Content="Annuler"
              IsCancel="True" VerticalAlignment="Center"
              Style="{DynamicResource NMButtonAnnuler}"/>
    </Grid>
  </Grid>

</Window>
