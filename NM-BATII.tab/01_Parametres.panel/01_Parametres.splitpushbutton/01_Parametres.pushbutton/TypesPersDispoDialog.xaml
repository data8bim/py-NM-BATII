<?xml version="1.0" encoding="utf-8"?>
<Window
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Disponibilites vues personnalisees"
  Width="460" Height="360"
  ResizeMode="NoResize"
  WindowStartupLocation="CenterOwner">

  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="Disponibilite des vues personnalisees dans les scripts :"
               TextWrapping="Wrap"
               Margin="0,0,0,8"/>

    <DataGrid x:Name="dgDispo"
              Grid.Row="1"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              HeadersVisibility="Column"
              SelectionMode="Single"
              Margin="0,0,0,8">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Label"
                            Binding="{Binding label}"
                            Width="*"
                            IsReadOnly="True"/>
        <DataGridCheckBoxColumn Binding="{Binding lier_cao, Mode=TwoWay}"
                                Width="80">
          <DataGridCheckBoxColumn.HeaderTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="Lier CAO" HorizontalAlignment="Center"/>
                <TextBlock Text="&#x2192; Vues" HorizontalAlignment="Center"/>
              </StackPanel>
            </DataTemplate>
          </DataGridCheckBoxColumn.HeaderTemplate>
        </DataGridCheckBoxColumn>
        <DataGridCheckBoxColumn Binding="{Binding vues_plus, Mode=TwoWay}"
                                Width="70">
          <DataGridCheckBoxColumn.HeaderTemplate>
            <DataTemplate>
              <TextBlock Text="Vues +" HorizontalAlignment="Center"/>
            </DataTemplate>
          </DataGridCheckBoxColumn.HeaderTemplate>
        </DataGridCheckBoxColumn>
      </DataGrid.Columns>
    </DataGrid>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="btnOk"     Content="OK"      Width="80" Margin="0,0,8,0"/>
      <Button x:Name="btnCancel" Content="Annuler" Width="80"/>
    </StackPanel>
  </Grid>

</Window>
