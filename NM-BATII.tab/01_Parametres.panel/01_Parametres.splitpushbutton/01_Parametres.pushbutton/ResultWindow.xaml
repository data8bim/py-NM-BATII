<?xml version="1.0" encoding="utf-8"?>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Résultat"
        SizeToContent="WidthAndHeight"
        MinWidth="320"
        MaxWidth="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="14">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barre de statut coloree (success / warning / error) -->
        <Border x:Name="statusBar" Grid.Row="0" Background="DodgerBlue"/>

        <!-- Titre -->
        <TextBlock x:Name="txtTitle"
                   Grid.Row="1"
                   FontSize="15"
                   FontWeight="Bold"
                   Foreground="#333333"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="12,10,12,2"/>

        <!-- Message principal -->
        <TextBlock x:Name="txtMessage"
                   Grid.Row="2"
                   FontSize="14"
                   Foreground="#333333"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="12,4,12,4"/>

        <!-- Details optionnels (masques si vides) -->
        <Border x:Name="detailsBorder"
                Grid.Row="3"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                CornerRadius="3"
                Margin="12,6,12,0"
                Padding="8"
                Visibility="Collapsed">
            <TextBlock x:Name="txtDetails"
                       FontSize="12"
                       Foreground="#666666"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Bouton Fermer -->
        <Button x:Name="btnClose"
                Content="Fermer"
                Grid.Row="5"
                HorizontalAlignment="Stretch"
                Margin="12,0,12,12"
                Padding="10,6"
                FontSize="14"
                IsDefault="True"/>
    </Grid>

</Window>
