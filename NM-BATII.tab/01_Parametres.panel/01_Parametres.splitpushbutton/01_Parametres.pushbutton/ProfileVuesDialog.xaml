<?xml version="1.0" encoding="utf-8"?>
<Window
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Options de vues"
  Width="480"
  SizeToContent="Height"
  ResizeMode="NoResize"
  WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <Style TargetType="TextBlock" BasedOn="{StaticResource NMTextBlockStandard}"/>
    <Style TargetType="ComboBox"  BasedOn="{StaticResource NMComboBoxStandard}"/>
    <Style TargetType="CheckBox"  BasedOn="{StaticResource NMCheckBoxStandard}"/>
    <Style TargetType="Button"    BasedOn="{StaticResource NMButtonStandard}"/>
  </Window.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="12"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="160"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <TextBlock Text="Famille de vue :" VerticalAlignment="Center"
               Grid.Row="0" Grid.Column="0" Margin="0,4"/>
    <ComboBox x:Name="cmbFamille" Grid.Row="0" Grid.Column="1" Margin="0,2">
      <ComboBoxItem>Plan d'etage</ComboBoxItem>
      <ComboBoxItem>Plans de faux-plafonds</ComboBoxItem>
      <ComboBoxItem>Plan de structure</ComboBoxItem>
      <ComboBoxItem>Vue de dessin</ComboBoxItem>
    </ComboBox>

    <TextBlock Text="Type personnalisé :" VerticalAlignment="Center"
               Grid.Row="1" Grid.Column="0" Margin="0,4"/>
    <ComboBox x:Name="cmbTypePerso" Grid.Row="1" Grid.Column="1" Margin="0,2"/>

    <CheckBox x:Name="chkVueParNiveau"
              Content="Une vue par niveau"
              Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4"/>

    <!-- Pied de dialogue standard NM-BATII : proportions * | 8 | 130 -->
    <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="130"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" x:Name="btnOK" Content="▶  Appliquer"
              IsDefault="True" Style="{DynamicResource NMButtonAppliquer}"/>
      <Button Grid.Column="2" x:Name="btnCancel" Content="Annuler"
              IsCancel="True" VerticalAlignment="Center"
              Style="{DynamicResource NMButtonAnnuler}"/>
    </Grid>
  </Grid>
</Window>
