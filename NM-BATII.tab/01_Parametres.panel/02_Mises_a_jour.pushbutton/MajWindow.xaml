<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mise à jour NM-BATII"
        Width="500" Height="320"
        MinWidth="420" MinHeight="260"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="13">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="4"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Barre de statut colorée -->
    <Border x:Name="statusBar" Grid.Row="0" Background="DodgerBlue"/>

    <!-- Contenu -->
    <StackPanel Grid.Row="1" Margin="16,14,16,8">

      <!-- Bloc versions -->
      <Border Background="#F5F5F5"
              BorderBrush="#DDDDDD"
              BorderThickness="1"
              CornerRadius="4"
              Padding="12,8"
              Margin="0,0,0,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,4" Text="Version installée :"
                     Foreground="#555555"/>
          <TextBlock x:Name="txtVersionInstallee" Grid.Row="0" Grid.Column="1" Margin="0,4"
                     FontWeight="Bold" Foreground="#333333"/>

          <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4" Text="Version disponible :"
                     Foreground="#555555"/>
          <TextBlock x:Name="txtVersionDispo" Grid.Row="1" Grid.Column="1" Margin="0,4"
                     FontWeight="Bold" Foreground="#333333" Text="Vérification en cours..."/>
        </Grid>
      </Border>

      <!-- Zone de message -->
      <Border x:Name="msgBorder"
              Background="#F0F8FF"
              BorderBrush="DodgerBlue"
              BorderThickness="1"
              CornerRadius="4"
              Padding="12,8">
        <TextBlock x:Name="txtMessage"
                   TextWrapping="Wrap"
                   Foreground="#333333"
                   Text=""/>
      </Border>

    </StackPanel>

    <!-- Pied de dialogue standard NM-BATII : proportions * | 8 | 130.
         Les ControlTemplate inline ont ete retires : poses directement sur le
         bouton, ils ecrasaient le template des styles partages. L'etat
         desactive (btnInstaller pilote par script.py) est desormais gere par
         le trigger IsEnabled du style NMButtonAppliquer. -->
    <Grid Grid.Row="2" Margin="16,0,16,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="130"/>
      </Grid.ColumnDefinitions>

      <Button Grid.Column="0" x:Name="btnInstaller"
              Content="▶  Installer la mise à jour"
              IsEnabled="False"
              Style="{DynamicResource NMButtonAppliquer}"/>

      <Button Grid.Column="2" x:Name="btnFermer"
              Content="Fermer"
              IsCancel="True"
              VerticalAlignment="Center"
              Style="{DynamicResource NMButtonAnnuler}"/>
    </Grid>
  </Grid>
</Window>
