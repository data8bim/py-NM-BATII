<?xml version="1.0" encoding="utf-8"?>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Liaison en cours"
        SizeToContent="Height" MinHeight="155" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource NMTextBlockStandard}" />
        <Style TargetType="Button"    BasedOn="{StaticResource NMButtonStandard}" />
    </Window.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Compteur : "Liaison (x/total) :" -->
        <TextBlock x:Name="lblCounter"
                   Text="Liaison..."
                   FontSize="15"
                   FontWeight="SemiBold"
                   Grid.Row="0"/>

        <!-- Nom du fichier sur une ligne dédiée -->
        <TextBlock x:Name="lblMessage"
                   Text=""
                   FontSize="12"
                   TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                   Margin="0,2,0,0"
                   Grid.Row="1"/>

        <ProgressBar x:Name="progressBar"
                     Grid.Row="2"
                     Height="18"
                     Minimum="0"
                     Maximum="100"
                     Value="0"
                     Margin="0,8,0,0"/>

        <!-- Fenetre de progression : le bouton interrompt le traitement en
             cours, il garde donc le style de sortie (et non le style
             Appliquer reserve aux fenetres de resultat a bouton unique).
             PAS de IsCancel ici : cette fenetre est affichee par Show() et non
             ShowDialog(), et son handler on_cancel (script.py) leve deja le
             drapeau _cancelled puis appelle Close(). -->
        <Button x:Name="btnCancel"
                Content="Annuler"
                Grid.Row="3"
                Width="130"
                HorizontalAlignment="Right"
                Margin="0,8,0,0"
                Style="{DynamicResource NMButtonAnnuler}"/>
    </Grid>
</Window>
