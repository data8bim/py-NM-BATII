<?xml version="1.0" encoding="utf-8"?>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lier fichier RVT"
		SizeToContent="WidthAndHeight"
		MinWidth="500"
		MaxWidth="550"
        ResizeMode="NoResize"
		WindowStartupLocation="CenterScreen">  
  
	<Window.Resources>	
		<Style TargetType="Window" BasedOn="{StaticResource NMWindowStandard}" />
		<Style TargetType="TextBlock" BasedOn="{StaticResource NMTextBlockStandard}" />
		<Style TargetType="Button" BasedOn="{StaticResource NMButtonValide}" />
	</Window.Resources> 
	
	<Grid Margin="5">
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
			<RowDefinition Height="*"/>
        </Grid.RowDefinitions>
		
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>  
		
		<Border BorderBrush="DodgerBlue"
				Grid.Row="0"
				Grid.Column="0" Grid.ColumnSpan="3"
				BorderThickness="1"
				CornerRadius="3"
				Padding="10"
				Margin="5">

			<TextBlock	x:Name="txtMessage"
						TextWrapping="Wrap"
						FontSize="18"
						FontWeight="Medium"
						TextAlignment="Center"
						VerticalAlignment="Center" />
		</Border>

		<!-- Fenetre a bouton unique : pleine largeur, style Appliquer.
		     Pas de bouton Annuler ajoute ici : le handler se contente de
		     Close() et le script poursuit ensuite, un Annuler serait trompeur
		     tant que l'abandon n'est pas gere cote script.py. -->
		<Button	x:Name="btnOk"
				Content="▶  Suivant"
				Grid.Row="2"
				Grid.Column="0" Grid.ColumnSpan="3"
				HorizontalAlignment="Stretch"
				IsDefault="True"
				Style="{DynamicResource NMButtonAppliquer}"/>

	</Grid>
</Window>
