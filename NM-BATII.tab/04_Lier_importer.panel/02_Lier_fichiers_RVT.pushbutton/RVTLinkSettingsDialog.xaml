<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paramètres des liens RVT"
        SizeToContent="WidthAndHeight"
        MinWidth="600"
        MinHeight="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Window" BasedOn="{StaticResource NMWindowStandard}" />
        <Style TargetType="TextBlock" BasedOn="{StaticResource NMTextBlockStandard}" />
        <Style TargetType="Button" BasedOn="{StaticResource NMButtonStandard}" />
		<Style x:Key="NMButtonValideOnly" TargetType="Button" BasedOn="{StaticResource NMButtonValide}" />
        <Style TargetType="ComboBox" BasedOn="{StaticResource NMComboBoxStandard}" />
        <Style TargetType="CheckBox" BasedOn="{StaticResource NMCheckBoxStandard}" />
    </Window.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

		<!-- Barre d'application en masse -->
		 <Grid Grid.Row="0" Margin="0,0,0,10">
			<Grid.RowDefinitions>
				<RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Appliquer à la sélection :" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="cmbMassReferenceType" Grid.Column="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Width="150"  Margin="0,0,10,0" VerticalContentAlignment="Center">
                <ComboBoxItem>Superposition</ComboBoxItem>
                <ComboBoxItem>Attachement</ComboBoxItem>
            </ComboBox>
            <CheckBox x:Name="chkMassRoomBounding" Content="Limite de pièce" Grid.Column="2" Margin="0,0,10,0"/>
            <Button x:Name="btnApplyMass" Content="Appliquer" Grid.Column="3" Width="100"/>
        </Grid>
		
		
		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
		
			<!-- Tableau principal -->
			<DataGrid x:Name="dgLinks"
					  Grid.Column="1"
					  HorizontalAlignment="Stretch"
					  VerticalAlignment="Stretch"
					  AutoGenerateColumns="False"
					  CanUserAddRows="False"
					  CanUserDeleteRows="False"
					  SelectionMode="Extended"
					  SelectionUnit="FullRow"
					  HeadersVisibility="Column"
					  Margin="0,0,0,10">
				<DataGrid.Columns>
					<DataGridTextColumn Header="Fichier"
										Binding="{Binding Name}"
										IsReadOnly="True">
						<DataGridTextColumn.ElementStyle>
							<Style TargetType="TextBlock">
								<Setter Property="Padding" Value="0,0,50,0"/>
							</Style>
						</DataGridTextColumn.ElementStyle>
					</DataGridTextColumn>
					<DataGridTemplateColumn Header="Type de référence">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding ReferenceType}"/>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
						<DataGridTemplateColumn.CellEditingTemplate>
							<DataTemplate>
								<ComboBox ItemsSource="{Binding ReferenceOptions}"
										  SelectedItem="{Binding ReferenceType, Mode=TwoWay}"
										  Margin="2"/>
							</DataTemplate>
						</DataGridTemplateColumn.CellEditingTemplate>
					</DataGridTemplateColumn>
					<DataGridCheckBoxColumn Header="Limite de pièce"
											Binding="{Binding RoomBounding, Mode=TwoWay}"/>
				</DataGrid.Columns>
			</DataGrid>
		</Grid>
		
		<Grid Grid.Row="2">
        <!-- Validation -->
			<!-- Fenetre a bouton unique : pleine largeur, style Appliquer. -->
			<Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
			<Button x:Name="btnSettingsOk" Content="▶  Appliquer"
                    Style="{DynamicResource NMButtonAppliquer}"
                    IsDefault="True" Grid.Column="0"/>
		</Grid>
    </Grid>
</Window>
