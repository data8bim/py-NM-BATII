<?xml version="1.0" encoding="utf-8"?>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NM-BATII &#x2014; Rapport de cr&#xe9;ation"
        SizeToContent="WidthAndHeight"
        MinWidth="480"
        MaxWidth="720"
        MinHeight="300"
        MaxHeight="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Window" BasedOn="{StaticResource NMWindowStandard}" />
        <Style TargetType="TextBlock" BasedOn="{StaticResource NMTextBlockStandard}" />
        <Style TargetType="Button" BasedOn="{StaticResource NMButtonValide}" />
    </Window.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Résumé en-tête -->
        <Border BorderBrush="DodgerBlue"
                Grid.Row="0"
                Grid.Column="0" Grid.ColumnSpan="3"
                BorderThickness="1"
                CornerRadius="3"
                Padding="10"
                Margin="5">
            <TextBlock x:Name="txtResume"
                       TextWrapping="Wrap"
                       FontSize="16"
                       FontWeight="Medium"
                       TextAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- Détail des vues créées -->
        <TextBlock Text="Vues cr&#xe9;&#xe9;es :"
                   Grid.Row="2"
                   Grid.Column="0" Grid.ColumnSpan="3"
                   FontWeight="Bold"/>

        <Border Grid.Row="4"
                Grid.Column="0" Grid.ColumnSpan="3"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="2"
                Margin="5,0,5,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock x:Name="txtCreees"
                               TextWrapping="Wrap"
                               Padding="6"
                               FontFamily="Consolas"
                               FontSize="11"/>
                    <TextBlock x:Name="txtIgnorees"
                               TextWrapping="Wrap"
                               Padding="6"
                               FontFamily="Consolas"
                               FontSize="11"
                               Foreground="DarkOrange"/>
                    <TextBlock x:Name="txtErreurs"
                               TextWrapping="Wrap"
                               Padding="6"
                               FontFamily="Consolas"
                               FontSize="11"
                               Foreground="Red"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Button x:Name="btnClose"
                Content="Fermer"
                Grid.Row="6"
                Grid.Column="0" Grid.ColumnSpan="3"
                HorizontalAlignment="Stretch"
                IsDefault="True"/>
    </Grid>
</Window>
