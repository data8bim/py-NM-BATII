<?xml version="1.0" encoding="utf-8"?>

<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NM-BATII &#x2014; Vues +"
    SizeToContent="WidthAndHeight"
    MinWidth="500"
    MaxWidth="700"
    MinHeight="500"
    MaxHeight="800"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Window" BasedOn="{StaticResource NMWindowStandard}" />
        <Style TargetType="TextBlock" BasedOn="{StaticResource NMTextBlockStandard}" />
        <Style TargetType="Button" BasedOn="{StaticResource NMButtonStandard}" />
        <Style x:Key="NMButtonValideOnly" TargetType="Button" BasedOn="{StaticResource NMButtonValide}" />
        <Style TargetType="ComboBox" BasedOn="{StaticResource NMComboBoxStandard}" />
        <Style TargetType="ListBox" BasedOn="{StaticResource NMListBoxStandard}" />

        <!-- Libelle de menu : colonne de gauche, aligne a droite contre son
             menu. Sans NoWrap, la colonne Auto se laisserait comprimer et les
             libelles passeraient sur deux lignes. -->
        <Style x:Key="NMLabelMenu" TargetType="TextBlock"
               BasedOn="{StaticResource NMTextBlockStandard}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="TextWrapping"        Value="NoWrap"/>
            <Setter Property="Margin"              Value="0,2,6,2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><!-- 0 : menus (libelle + liste) -->
            <RowDefinition Height="10"/> <!-- 1 : spacer -->
            <RowDefinition Height="Auto"/><!-- 2 : label filtres -->
            <RowDefinition Height="Auto"/><!-- 3 : WrapPanel filtres checkboxes -->
            <RowDefinition Height="10"/> <!-- 4 : spacer -->
            <RowDefinition Height="Auto"/><!-- 5 : label niveaux -->
            <RowDefinition Height="*"/>  <!-- 6 : ListBox niveaux -->
            <RowDefinition Height="Auto"/><!-- 7 : boutons sélection -->
            <RowDefinition Height="20"/> <!-- 8 : spacer -->
            <RowDefinition Height="Auto"/><!-- 9 : boutons Valider/Annuler -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- CASCADE : Discipline -> Sous-discipline -> Famille de vue ->
             Type personnalise. Chaque menu ne propose que des valeurs laissant
             au moins un choix au suivant (voir _maj_* dans script.py).
             Les disciplines offertes sont celles REELLEMENT employees par les
             vues personnalisees, pas les ~100 lignes du referentiel de
             l'onglet « Disciplines ».
             Ces quatre menus sont editables : la frappe y filtre les valeurs
             (dialogs/combo_recherche.py). Le cinquieme, « Phase(s) », est une
             liste a COCHER (dialogs/combo_multi_cases.py) : plusieurs phases a
             la fois, meme champ de recherche, Ctrl/Maj+Clic pour le cochage en
             masse.
             ShowOnDisabled : sans lui, l'infobulle expliquant
             l'indisponibilite ne s'afficherait justement pas sur un menu
             grise.
             Libelle a gauche du menu et non au-dessus : cinq lignes empilees
             sur deux hauteurs chacune faisaient une fenetre inutilement
             longue. -->
        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><!-- Discipline -->
                <RowDefinition Height="Auto"/><!-- Sous-discipline -->
                <RowDefinition Height="Auto"/><!-- Famille de vue -->
                <RowDefinition Height="Auto"/><!-- Type personnalisé -->
                <RowDefinition Height="Auto"/><!-- Phase(s) -->
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0"
                       Style="{StaticResource NMLabelMenu}"
                       Text="Discipline :"/>
            <ComboBox  Grid.Row="0" Grid.Column="1"
                       x:Name="cmbDiscipline"
                       ToolTipService.ShowOnDisabled="True"/>

            <!-- Sous-discipline : bornee a la discipline choisie -->
            <TextBlock Grid.Row="1" Grid.Column="0"
                       Style="{StaticResource NMLabelMenu}"
                       Text="Sous-discipline :"/>
            <ComboBox  Grid.Row="1" Grid.Column="1"
                       x:Name="cmbSousDiscipline"
                       ToolTipService.ShowOnDisabled="True"/>

            <TextBlock Grid.Row="2" Grid.Column="0"
                       Style="{StaticResource NMLabelMenu}"
                       Text="Famille de vue :"/>
            <ComboBox  Grid.Row="2" Grid.Column="1"
                       x:Name="cmbViewFamily"
                       ToolTipService.ShowOnDisabled="True"/>

            <TextBlock Grid.Row="3" Grid.Column="0"
                       Style="{StaticResource NMLabelMenu}"
                       Text="Type personnalis&#233; :"/>
            <ComboBox  Grid.Row="3" Grid.Column="1"
                       x:Name="cmbVueTypePers"
                       ToolTipService.ShowOnDisabled="True"/>

            <TextBlock Grid.Row="4" Grid.Column="0"
                       Style="{StaticResource NMLabelMenu}"
                       Text="Phase(s) :"/>
            <ComboBox  Grid.Row="4" Grid.Column="1"
                       x:Name="cmbPhases"
                       ToolTipService.ShowOnDisabled="True"/>
        </Grid>

        <!-- Filtres par type de niveau -->
        <TextBlock x:Name="txtLabelFiltres"
                   Text="Filtrer par type de niveau :"
                   Grid.Row="2"
                   Grid.Column="0" Grid.ColumnSpan="3"/>

        <Border Grid.Row="3"
                Grid.Column="0" Grid.ColumnSpan="3"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="2"
                Padding="6,4"
                Margin="0,0,0,0">
            <WrapPanel x:Name="pnlFiltresTypes"
                       Orientation="Horizontal"/>
        </Border>

        <!-- Liste des niveaux -->
        <TextBlock x:Name="txtLabelNiveaux"
                   Text="Cochez les niveaux b&#226;timent &#224; traiter :"
                   Grid.Row="5"
                   Grid.Column="0" Grid.ColumnSpan="3"
                   ToolTipService.ShowOnDisabled="True"/>

        <ListBox
            x:Name="lstNiveaux"
            SelectionMode="Multiple"
            HorizontalContentAlignment="Stretch"
            Grid.Row="6"
            Grid.Column="0" Grid.ColumnSpan="3">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected,
                                          RelativeSource={RelativeSource AncestorType=ListBoxItem},
                                          Mode=TwoWay}">
                        <TextBlock Text="{Binding}"/>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Boutons sélection -->
        <Button x:Name="btnSelectAll"
                Content="S&#233;lectionner tout"
                Grid.Row="7"
                Grid.Column="0"/>

        <Button x:Name="btnDeselectAll"
                Content="D&#233;s&#233;lectionner tout"
                Grid.Row="7"
                Grid.Column="1"/>

        <Button x:Name="btnInvert"
                Content="Inverser"
                Grid.Row="7"
                Grid.Column="2"/>

        <!-- Pied de dialogue standard NM-BATII : proportions * | 8 | 130 -->
        <Grid Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="btnOk"
                    Content="▶  Appliquer"
                    Style="{DynamicResource NMButtonAppliquer}"
                    IsDefault="True"/>
            <Button Grid.Column="2" x:Name="btnCancel"
                    Content="Annuler"
                    Style="{DynamicResource NMButtonAnnuler}"
                    IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
