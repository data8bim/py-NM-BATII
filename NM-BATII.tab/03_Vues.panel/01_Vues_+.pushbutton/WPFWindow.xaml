<?xml version="1.0" encoding="utf-8"?>

<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NM-BATII &#x2014; Vues +"
    SizeToContent="WidthAndHeight"
    MinWidth="500"
    MaxWidth="700"
    MinHeight="500"
    MaxHeight="800"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Window" BasedOn="{StaticResource NMWindowStandard}" />
        <Style TargetType="TextBlock" BasedOn="{StaticResource NMTextBlockStandard}" />
        <Style TargetType="Button" BasedOn="{StaticResource NMButtonStandard}" />
        <Style x:Key="NMButtonValideOnly" TargetType="Button" BasedOn="{StaticResource NMButtonValide}" />
        <Style TargetType="ComboBox" BasedOn="{StaticResource NMComboBoxStandard}" />
        <Style TargetType="ListBox" BasedOn="{StaticResource NMListBoxStandard}" />
    </Window.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><!-- 0 : label famille vue -->
            <RowDefinition Height="Auto"/><!-- 1 : cmbViewFamily -->
            <RowDefinition Height="8"/>  <!-- 2 : spacer -->
            <RowDefinition Height="Auto"/><!-- 3 : label type personnalise -->
            <RowDefinition Height="Auto"/><!-- 4 : cmbVueTypePers -->
            <RowDefinition Height="10"/> <!-- 5 : spacer -->
            <RowDefinition Height="Auto"/><!-- 6 : label filtres -->
            <RowDefinition Height="Auto"/><!-- 7 : WrapPanel filtres checkboxes -->
            <RowDefinition Height="10"/> <!-- 8 : spacer -->
            <RowDefinition Height="Auto"/><!-- 9 : label niveaux -->
            <RowDefinition Height="*"/>  <!-- 10: ListBox niveaux -->
            <RowDefinition Height="Auto"/><!-- 11: boutons sélection -->
            <RowDefinition Height="20"/> <!-- 12: spacer -->
            <RowDefinition Height="Auto"/><!-- 13: boutons Valider/Annuler -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Famille de vue -->
        <TextBlock Text="Famille de vue :"
                   Grid.Row="0"
                   Grid.Column="0" Grid.ColumnSpan="3"/>

        <ComboBox x:Name="cmbViewFamily"
                  Grid.Row="1"
                  Grid.Column="0" Grid.ColumnSpan="3"/>

        <!-- Type personnalise -->
        <TextBlock Text="Type personnalis&#233; :"
                   Grid.Row="3"
                   Grid.Column="0" Grid.ColumnSpan="3"/>

        <ComboBox x:Name="cmbVueTypePers"
                  Grid.Row="4"
                  Grid.Column="0" Grid.ColumnSpan="3"/>

        <!-- Filtres par type de niveau -->
        <TextBlock Text="Filtrer par type de niveau :"
                   Grid.Row="6"
                   Grid.Column="0" Grid.ColumnSpan="3"/>

        <Border Grid.Row="7"
                Grid.Column="0" Grid.ColumnSpan="3"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="2"
                Padding="6,4"
                Margin="0,0,0,0">
            <WrapPanel x:Name="pnlFiltresTypes"
                       Orientation="Horizontal"/>
        </Border>

        <!-- Liste des niveaux -->
        <TextBlock Text="Cochez les niveaux b&#226;timent &#224; traiter :"
                   Grid.Row="9"
                   Grid.Column="0" Grid.ColumnSpan="3"/>

        <ListBox
            x:Name="lstNiveaux"
            SelectionMode="Multiple"
            HorizontalContentAlignment="Stretch"
            Grid.Row="10"
            Grid.Column="0" Grid.ColumnSpan="3">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected,
                                          RelativeSource={RelativeSource AncestorType=ListBoxItem},
                                          Mode=TwoWay}">
                        <TextBlock Text="{Binding}"/>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Boutons sélection -->
        <Button x:Name="btnSelectAll"
                Content="S&#233;lectionner tout"
                Grid.Row="11"
                Grid.Column="0"/>

        <Button x:Name="btnDeselectAll"
                Content="D&#233;s&#233;lectionner tout"
                Grid.Row="11"
                Grid.Column="1"/>

        <Button x:Name="btnInvert"
                Content="Inverser"
                Grid.Row="11"
                Grid.Column="2"/>

        <!-- Valider / Annuler -->
        <Button x:Name="btnOk"
                Content="Valider"
                Style="{StaticResource NMButtonValideOnly}"
                Grid.Row="13"
                Grid.Column="1"/>

        <Button x:Name="btnCancel"
                Content="Annuler"
                Style="{StaticResource NMButtonValideOnly}"
                IsCancel="True"
                Grid.Row="13"
                Grid.Column="2"/>
    </Grid>
</Window>
