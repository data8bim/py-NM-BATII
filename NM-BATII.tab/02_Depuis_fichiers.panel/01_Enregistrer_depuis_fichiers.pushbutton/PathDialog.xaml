<?xml version="1.0" encoding="utf-8"?>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Terminé"
		SizeToContent="Height"
		Width="500"
		MinWidth="500"
        ResizeMode="NoResize"
		WindowStartupLocation="CenterScreen">
		
	<Window.Resources>
		<Style TargetType="Window" BasedOn="{StaticResource NMWindowStandard}" />
		<Style TargetType="TextBlock" BasedOn="{StaticResource NMTextBlockStandard}" />
		<Style TargetType="TextBox" BasedOn="{StaticResource NMTextBoxStandard}" />
		<Style TargetType="Button" BasedOn="{StaticResource NMButtonStandard}" />
		<Style x:Key="NMButtonValideOnly" TargetType="Button" BasedOn="{StaticResource NMButtonValide}" />
	</Window.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
		
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

        <TextBlock	Grid.Row="0"
					Grid.Column="0" Grid.ColumnSpan="3"
					Text="Fichier enregistré à l'emplacement suivant :" />

        <TextBox	Grid.Row="1"
					Grid.Column="0" Grid.ColumnSpan="3"
					x:Name="txtPath"
					IsReadOnly="True"
					TextWrapping="Wrap"
					VerticalScrollBarVisibility="Auto" />

        <Button Grid.Row="2"
				Grid.Column="0" Grid.ColumnSpan="3"
                x:Name="btnCopy"
                Content="Copier dans le presse-papier"/>

        <!-- Fenetre a bouton unique : "Fermer" prend le style Appliquer sur
             toute la largeur, puisqu'il est la seule action de sortie. -->
        <Button Grid.Row="3"
				Grid.Column="0" Grid.ColumnSpan="3"
                x:Name="btnClose"
                Content="Fermer"
                HorizontalAlignment="Stretch"
                IsDefault="True"
				Style="{DynamicResource NMButtonAppliquer}" />

    </Grid>
</Window>
