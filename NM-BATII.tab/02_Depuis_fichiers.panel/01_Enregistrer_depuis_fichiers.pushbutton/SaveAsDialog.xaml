<?xml version="1.0" encoding="utf-8"?>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enregistrer sous"
        SizeToContent="WidthAndHeight"
        MinWidth="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Window"    BasedOn="{StaticResource NMWindowStandard}" />
        <Style TargetType="TextBlock" BasedOn="{StaticResource NMTextBlockStandard}" />
        <Style TargetType="TextBox"   BasedOn="{StaticResource NMTextBoxStandard}" />
        <Style TargetType="CheckBox"  BasedOn="{StaticResource NMCheckBoxStandard}" />
        <Style TargetType="Button"    BasedOn="{StaticResource NMButtonValide}" />
        <Style TargetType="Separator" />
    </Window.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">

        <!-- mainPanel : la grille de groupes sera insérée à l'index 0 depuis Python -->
        <StackPanel x:Name="mainPanel" Margin="10">

            <Separator Margin="0,8,0,8"/>

            <TextBlock x:Name="lblPreview"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"
                       FontWeight="Bold"/>

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnOk"
                        Content="Enregistrer"
                        Grid.Column="1"
                        MinWidth="120"
                        Margin="0,0,6,0"/>

                <Button x:Name="btnCancel"
                        Content="Annuler"
                        Grid.Column="2"
                        MinWidth="80"/>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Window>
