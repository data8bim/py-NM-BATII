<?xml version="1.0" encoding="utf-8"?>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enregistrer sous"
        SizeToContent="WidthAndHeight"
        MinWidth="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Window"    BasedOn="{StaticResource NMWindowStandard}" />
        <Style TargetType="TextBlock" BasedOn="{StaticResource NMTextBlockStandard}" />
        <Style TargetType="TextBox"   BasedOn="{StaticResource NMTextBoxStandard}" />
        <Style TargetType="CheckBox"  BasedOn="{StaticResource NMCheckBoxStandard}" />
        <Style TargetType="Button"    BasedOn="{StaticResource NMButtonValide}" />
        <Style TargetType="Separator" />
    </Window.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">

        <!-- mainPanel : la grille de groupes sera insérée à l'index 0 depuis Python -->
        <StackPanel x:Name="mainPanel" Margin="10">

            <Separator Margin="0,8,0,8"/>

            <TextBlock x:Name="lblPreview"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"
                       FontWeight="Bold"/>

            <!-- Pied de dialogue standard NM-BATII : proportions * | 8 | 130.
                 Le verbe reste "Enregistrer" : l'action ecrit un fichier. -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="btnOk"
                        Content="▶  Enregistrer"
                        Style="{DynamicResource NMButtonAppliquer}"
                        IsDefault="True"/>

                <Button Grid.Column="2" x:Name="btnCancel"
                        Content="Annuler"
                        Style="{DynamicResource NMButtonAnnuler}"
                        IsCancel="True"/>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Window>
