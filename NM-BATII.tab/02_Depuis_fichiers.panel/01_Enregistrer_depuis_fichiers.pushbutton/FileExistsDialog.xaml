<?xml version="1.0" encoding="utf-8"?>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fichier existant"
		SizeToContent="Height"
		Width="500"
		MinWidth="500"
        ResizeMode="NoResize"
		WindowStartupLocation="CenterScreen" >
		
	<Window.Resources>
		<Style TargetType="Window" BasedOn="{StaticResource NMWindowStandard}" />
		<Style TargetType="TextBlock" BasedOn="{StaticResource NMTextBlockStandard}" />
		<Style TargetType="TextBox" BasedOn="{StaticResource NMTextBoxStandard}" />
		<Style TargetType="Button" BasedOn="{StaticResource NMButtonValide}" />
		<!-- <Style x:Key="NMButtonValideOnly" TargetType="Button" BasedOn="{StaticResource NMButtonValide}" /> -->
	</Window.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
        </Grid.RowDefinitions>
		
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>
        
		
		<TextBlock  Grid.Row="0"
					Grid.Column="0" Grid.ColumnSpan="3"
					Text="Le fichier existe déjà :" />

        <TextBox Grid.Row="1"
				 Grid.Column="0" Grid.ColumnSpan="3"
				 x:Name="txtPath"
				 IsReadOnly="True"
				 TextWrapping="Wrap"
				 VerticalScrollBarVisibility="Auto" />

		<!-- Pied a 2 actions principales de meme niveau : deux colonnes
		     elastiques egales (*), meme style Appliquer. "Annuler" garde la
		     largeur fixe 130 du bouton de sortie ; le script gere deja
		     l'abandon (if not win.show_dialog(): return None).
		     Grid.Row corrige de 3 a 2 : le Grid ne definit que 3 lignes (0-2),
		     WPF rabattait silencieusement les boutons sur la derniere. -->
		<Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="8"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="8"/>
				<ColumnDefinition Width="130"/>
			</Grid.ColumnDefinitions>

			<Button Grid.Column="0" x:Name="btnRename"
					Content="▶  Renommer"
					Style="{DynamicResource NMButtonAppliquer}"
					IsDefault="True" />

			<Button Grid.Column="2" x:Name="btnReplace"
					Content="▶  Remplacer"
					Style="{DynamicResource NMButtonAppliquer}" />

			<Button Grid.Column="4" x:Name="btnCancel"
					Content="Annuler"
					Style="{DynamicResource NMButtonAnnuler}"
					IsCancel="True" />
		</Grid>

    </Grid>
</Window>
