<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sélection de la couleur"
        Height="340" MinHeight="100"
        Width="400" MaxWidth="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="BoutonAppliquer" TargetType="Button" BasedOn="{StaticResource NMButtonValide}">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="30"/>
        </Style>
        <Style x:Key="BoutonAnnuler" TargetType="Button" BasedOn="{StaticResource NMButtonValide}">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="30"/>
        </Style>
    </Window.Resources>

    <!-- DISTRIBUTION DES GRIDS PRINCIPAUX -->
    <Grid Margin="5,0,5,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- En-tête -->
            <RowDefinition Height="Auto"/>   <!-- Zone couleurs -->
            <RowDefinition Height="Auto"/>   <!-- Texte explicatif -->
            <RowDefinition Height="Auto"/>   <!-- Boutons -->
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Grid Grid.Row="0" Margin="15,5,15,5">
            <TextBlock Text="Couleurs standards appliquées automatiquement"
                       FontSize="14"
                       FontWeight="SemiBold"/>
        </Grid>

        <!-- Zone de couleurs -->
        <Grid Grid.Row="1" Margin="15,0,15,0">
            <StackPanel x:Name="standards_panel"/>
        </Grid>

        <!-- Texte explicatif -->
        <Grid Grid.Row="2" Margin="15,0,15,0">
            <TextBlock TextWrapping="Wrap"
                       FontSize="11"
                       Foreground="#666666">
                Les couleurs ci-dessus seront appliquées automatiquement aux colonnes :<LineBreak/>
                • Lecture seule — couleur Lecture seule<LineBreak/>
                • Paramètres de Type — couleur Types<LineBreak/>
                • Paramètres d'Occurrence — couleur Occurences
            </TextBlock>
        </Grid>

        <!-- Boutons -->
        <Grid Grid.Row="3" Margin="5,5,5,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    x:Name="ok_button"
                    Content="Appliquer"
                    Style="{StaticResource BoutonAppliquer}"
                    Margin="0,0,10,0"
                    IsDefault="True"/>

            <Button Grid.Column="2"
                    x:Name="cancel_button"
                    Content="Annuler"
                    Style="{StaticResource BoutonAnnuler}"
                    IsCancel="True"/>
        </Grid>

    </Grid>
</Window>
