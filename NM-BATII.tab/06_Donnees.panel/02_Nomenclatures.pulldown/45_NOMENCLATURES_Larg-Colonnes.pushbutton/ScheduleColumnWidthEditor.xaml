<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurer les largeurs de colonnes"
        Height="720" Width="780"
        MinHeight="500" MinWidth="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- L1 : ComboBox nomenclature -->
            <RowDefinition Height="Auto"/>   <!-- L2 : Boutons + Appliquer masse -->
            <RowDefinition Height="Auto"/>   <!-- L3 : Filtre -->
            <RowDefinition Height="Auto"/>   <!-- En-tête colonnes -->
            <RowDefinition Height="*"/>      <!-- Liste colonnes -->
            <RowDefinition Height="Auto"/>   <!-- Validation inline -->
            <RowDefinition Height="Auto"/>   <!-- Boutons bas -->
        </Grid.RowDefinitions>

        <!-- ── L1 : Sélection nomenclature ────────────────────────── -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Nomenclature : "
                       FontWeight="SemiBold" FontSize="13"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="cboSchedule" Grid.Column="1"
                      Height="30" FontSize="12"
                      VerticalContentAlignment="Center"/>
        </Grid>

        <!-- ── L2 : Boutons sélection + Appliquer en masse ─────────── -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>    <!-- Tout sélectionner -->
                <ColumnDefinition Width="*"/>    <!-- Tout désélectionner -->
                <ColumnDefinition Width="*"/>    <!-- Inverser -->
                <ColumnDefinition Width="16"/>   <!-- séparateur visuel -->
                <ColumnDefinition Width="Auto"/> <!-- "Appliquer" -->
                <ColumnDefinition Width="72"/>   <!-- valeur -->
                <ColumnDefinition Width="Auto"/> <!-- "mm" -->
                <ColumnDefinition Width="Auto"/> <!-- bouton --> 
            </Grid.ColumnDefinitions>

            <Button x:Name="btnCheckAll" Grid.Column="0"
                    Content="Tout sélectionner"
                    Style="{DynamicResource NMButtonStandard}"
                    Height="30" Margin="0,0,3,0" IsEnabled="False"/>
            <Button x:Name="btnUncheckAll" Grid.Column="1"
                    Content="Tout désélectionner"
                    Style="{DynamicResource NMButtonStandard}"
                    Height="30" Margin="3,0,3,0" IsEnabled="False"/>
            <Button x:Name="btnToggleAll" Grid.Column="2"
                    Content="Inverser"
                    Style="{DynamicResource NMButtonStandard}"
                    Height="30" Margin="3,0,0,0" IsEnabled="False"/>

            <TextBlock Grid.Column="4" Text="Appliquer "
                       VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="txtMassWidth" Grid.Column="5"
                     Height="30" Text="25"
                     VerticalContentAlignment="Center"
                     TextAlignment="Right" IsEnabled="False"/>
            <TextBlock Grid.Column="6" Text=" mm"
                       VerticalAlignment="Center" Margin="4,0,8,0"/>
            <Button x:Name="btnApplyMass" Grid.Column="7"
                    Content="→ à la sélection"
                    Style="{DynamicResource NMButtonStandard}"
                    Height="30" Padding="10,0" IsEnabled="False"/>
        </Grid>

        <!-- ── L3 : Filtre paramètres ──────────────────────────────── -->
        <Grid Grid.Row="2" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ToggleButton Grid.Column="0" Width="36" Height="28"
                          IsEnabled="False" Margin="0,0,4,0">
                <TextBlock Text="AZ" FontWeight="Bold" FontSize="11"/>
            </ToggleButton>
            <TextBox x:Name="txtFilter" Grid.Column="1" Height="28"
                     VerticalContentAlignment="Center" IsEnabled="False"/>
        </Grid>

        <!-- ── En-tête du tableau ──────────────────────────────────── -->
        <!-- CB=30  TYPE=90  NAME=*  WIDTH=65  MM=30 -->
        <Border Grid.Row="3"
                Background="#EFF4FF"
                BorderBrush="#C7D7F5" BorderThickness="0,1,0,1"
                Padding="0,4,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="65"/>
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="Type"
                           FontWeight="SemiBold" FontSize="11"
                           VerticalAlignment="Center" Margin="4,0,4,0"/>
                <TextBlock Grid.Column="2" Text="Paramètre (colonne)"
                           FontWeight="SemiBold" FontSize="11"
                           VerticalAlignment="Center" Margin="4,0,8,0"/>
                <TextBlock Grid.Column="3" Text="Largeur"
                           FontWeight="SemiBold" FontSize="11"
                           TextAlignment="Right" VerticalAlignment="Center"
                           Margin="0,0,2,0"/>
                <TextBlock Grid.Column="4" Text="mm"
                           FontWeight="SemiBold" FontSize="11"
                           VerticalAlignment="Center" Margin="3,0,0,0"/>
            </Grid>
        </Border>

        <!-- ── Liste des colonnes ──────────────────────────────────── -->
        <ScrollViewer Grid.Row="4"
                      x:Name="scrollColumns"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="panelColumns" HorizontalAlignment="Stretch"/>
        </ScrollViewer>

        <!-- ── Validation inline ───────────────────────────────────── -->
        <Border Grid.Row="5" x:Name="borderValidation"
                Margin="0,8,0,0" Padding="10,6"
                Background="#FEF2F2" BorderBrush="#FECACA"
                BorderThickness="1" CornerRadius="4"
                Visibility="Collapsed">
            <TextBlock x:Name="txtValidation"
                       Foreground="#DC2626" FontWeight="SemiBold"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- ── Boutons bas ─────────────────────────────────────────── -->
        <Grid Grid.Row="6" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="160"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnCancel" Grid.Column="0"
                    Content="Annuler"
                    Style="{DynamicResource NMButtonStandard}"
                    Height="40" Margin="0,0,8,0"/>
            <Button x:Name="btnValider" Grid.Column="1"
                    Content="Valider"
                    Style="{DynamicResource NMButtonValide}"
                    Height="40" IsDefault="True"/>
        </Grid>
    </Grid>
</Window>
