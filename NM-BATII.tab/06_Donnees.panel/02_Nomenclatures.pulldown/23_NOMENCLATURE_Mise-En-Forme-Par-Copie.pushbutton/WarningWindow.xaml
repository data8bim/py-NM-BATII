<?xml version="1.0" encoding="utf-8"?>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copier mise en forme - Avertissement"
        Height="680" Width="650"
        MinHeight="550" MinWidth="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    
    <Window.Resources>
        <!-- Styles pour les boutons - AUTONOMES (sans dépendance NM) -->
        <Style x:Key="BoutonContinuer" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45A049"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#3D8B40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="BoutonAnnuler" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Background" Value="#F44336"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E53935"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#C62828"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Titre avec icône -->
        <Grid Grid.Row="0" Background="#FFF5E6" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Icône d'avertissement -->
            <Viewbox Grid.Column="0" Width="40" Height="40" Margin="20,15,10,15">
                <Canvas Width="24" Height="24">
                    <Path Fill="#FF9800" Data="M12,2L1,21h22L12,2z M13,18h-2v-2h2V18z M13,14h-2V9h2V14z"/>
                </Canvas>
            </Viewbox>
            
            <TextBlock Grid.Column="1" 
                       Text="Paramètres qui NE seront PAS copiés"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#E65100"
                       VerticalAlignment="Center"
                       Margin="0,0,20,0"/>
        </Grid>
        
        <!-- Contenu principal -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      Margin="10,0,10,0">
            <StackPanel>
                <!-- Introduction -->
                <TextBlock TextWrapping="Wrap" 
                           FontSize="13"
                           Margin="0,0,0,10">
                    <Run Text="Ce script copie automatiquement " FontWeight="Normal"/>
                    <Run Text="la plupart " FontWeight="Bold"/>
                    <Run Text="des paramètres de mise en forme :" FontWeight="Normal"/>
                </TextBlock>
                
                <!-- Paramètres COPIÉS -->
                <Border Background="#E8F5E9" 
                        BorderBrush="#4CAF50" 
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="✓ PARAMÈTRES COPIÉS AUTOMATIQUEMENT"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Foreground="#2E7D32"
                                   Margin="0,0,0,5"/>
                        
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,2">
                            <Run Text="• Titre du champ" FontWeight="Normal"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,2">
                            <Run Text="• Orientation de l'en-tête" FontWeight="Normal"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,2">
                            <Run Text="• Alignement horizontal" FontWeight="Normal"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,2">
                            <Run Text="• Champ masqué (IsHidden)" FontWeight="Normal"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,2">
                            <Run Text="• Format numérique (précision, arrondi, incrément, unités, etc.)" FontWeight="Normal"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                
                <!-- Paramètres NON COPIÉS -->
                <Border Background="#FFEBEE" 
                        BorderBrush="#F44336" 
                        BorderThickness="2"
                        CornerRadius="4"
                        Padding="10"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="✗ PARAMÈTRES NON COPIÉS"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Foreground="#C62828"
                                   Margin="0,0,0,5"/>
                        
                        <TextBlock TextWrapping="Wrap" 
                                   FontSize="12" 
                                   Foreground="#D32F2F"
                                   Margin="0,2">
                            <Run Text="• Mise en forme conditionnelle" FontWeight="SemiBold"/>
                            <LineBreak/>
                            <Run Text="  (règles, couleurs, conditions)" FontSize="11" FontStyle="Italic"/>
                        </TextBlock>
                        
                        <TextBlock TextWrapping="Wrap" 
                                   FontSize="12" 
                                   Foreground="#D32F2F"
                                   Margin="0,2">
                            <Run Text="• Indication de valeurs multiples" FontWeight="SemiBold"/>
                            <LineBreak/>
                            <Run Text="  (comportement, texte personnalisé)" FontSize="11" FontStyle="Italic"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                
                <!-- Raison -->
                <Border Background="#FFF3E0" 
                        BorderBrush="#FF9800" 
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="⚠ Pourquoi ?" 
                                   FontWeight="Bold"
                                   FontSize="12"
                                   Foreground="#E65100"
                                   Margin="0,0,0,5"/>
                        <TextBlock TextWrapping="Wrap" 
                                   FontSize="11"
                                   Foreground="#E65100">
                            <Run Text="L'API Revit ne fournit pas de méthodes pour copier ces paramètres programmatiquement."/>
                            <LineBreak/>
                            <Run Text="Ces paramètres devront être copiés " FontWeight="Normal"/>
                            <Run Text="MANUELLEMENT." FontWeight="Bold"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                
                <!-- Gain de temps -->
                <TextBlock TextWrapping="Wrap" 
                           FontSize="12"
                           FontStyle="Italic"
                           Foreground="#1976D2"
                           Margin="0,0,0,0">
                    <Run Text="💡 Malgré cette limitation, le script copie automatiquement " FontWeight="Normal"/>
                    <Run Text="~90% des paramètres" FontWeight="Bold"/>
                    <Run Text=", ce qui représente un " FontWeight="Normal"/>
                    <Run Text="gain de temps considérable" FontWeight="Bold"/>
                    <Run Text=" !" FontWeight="Normal"/>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
        
        <!-- Boutons -->
        <Grid Grid.Row="2" Margin="20,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <Button x:Name="btnContinuer" 
                    Grid.Column="1"
                    Content="Continuer" 
                    Style="{StaticResource BoutonContinuer}"
                    IsDefault="True"/>
					
            <Button x:Name="btnAnnuler" 
                    Grid.Column="3"
                    Content="Annuler" 
                    Style="{StaticResource BoutonAnnuler}"/>
            

        </Grid>
    </Grid>
</Window>
