<?xml version="1.0" encoding="utf-8"?>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sélectionner la nomenclature SOURCE"
        Height="600" Width="600"
        MinHeight="400" MinWidth="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    
    <Window.Resources>
        <!-- Styles UNIQUEMENT pour les boutons -->
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Message d'instruction -->
        <TextBlock Grid.Row="0" 
                   Margin="10,10,10,10"
                   TextWrapping="Wrap"
                   FontSize="13">
            <Run Text="Sélectionnez la nomenclature SOURCE dont vous souhaitez copier la configuration (paramètres + ordre)." FontWeight="SemiBold"/>
        </TextBlock>
        
        <!-- Zone de recherche -->
        <Grid Grid.Row="1" Margin="10,0,10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Bouton AZ (désactivé comme dans pyRevit) -->
            <ToggleButton x:Name="btnSearchMode" 
                          Grid.Column="0"
                          Width="40" 
                          Height="25"
                          IsEnabled="False"
                          Margin="0,0,5,0">
                <TextBlock Text="AZ" 
                           FontWeight="Bold"
                           FontSize="11"/>
            </ToggleButton>
            
            <!-- Zone de recherche -->
            <TextBox x:Name="txtSearch" 
                     Grid.Column="1"
                     Height="25"
                     VerticalContentAlignment="Center"/>
        </Grid>
        
        <!-- Liste des nomenclatures (sélection simple avec radio buttons) -->
        <ListBox x:Name="lstSchedules" 
                 Grid.Row="2"
                 Margin="10,0,10,5"
                 SelectionMode="Single"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="0"
                                        Padding="5,3,5,3">
                                    <RadioButton Content="{TemplateBinding Content}"
                                                 GroupName="SourceSchedule"
                                                 IsChecked="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                 IsHitTestVisible="False"
                                                 Focusable="False"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E5F3FF"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F0F0F0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
        
        <!-- Bouton Sélectionner -->
        <!-- Pied de dialogue standard NM-BATII : proportions * | 8 | 130 -->
        <Grid Grid.Row="3" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="btnOk"
                    Content="▶  Suivant"
                    Style="{DynamicResource NMButtonAppliquer}"
                    IsDefault="True"/>
            <Button Grid.Column="2" x:Name="btnCancel"
                    Content="Annuler"
                    Style="{DynamicResource NMButtonAnnuler}"
                    IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
