<?xml version="1.0" encoding="utf-8"?>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Colorer en-têtes par copie - Sélection CIBLES"
        Height="600" Width="620"
        MinHeight="400" MinWidth="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style x:Key="BoutonAction" TargetType="Button" BasedOn="{StaticResource NMButtonStandard}">
            <Setter Property="Height" Value="30"/>
        </Style>
        <Style x:Key="BoutonAppliquer" TargetType="Button" BasedOn="{StaticResource NMButtonValide}">
            <Setter Property="Height" Value="40"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Message d'instruction -->
        <Border Grid.Row="0"
                Margin="10,10,10,6"
                Background="#F0FFF4"
                BorderBrush="#A9DFBF"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10,8,10,8">
            <StackPanel>
                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#1E8449" Margin="0,0,0,4">
                    <Run Text="Étape 2 / 2 — Nomenclatures CIBLES"/>
                </TextBlock>
                <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="#333333">
                    <Run Text="Sélectionnez les nomenclatures sur lesquelles appliquer les couleurs d'en-têtes."/>
                    <LineBreak/>
                    <Run Text="Seules les colonnes ayant les mêmes paramètres que la source seront colorées."/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Zone de recherche -->
        <Grid Grid.Row="1" Margin="10,0,10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ToggleButton x:Name="btnSearchMode"
                          Grid.Column="0"
                          Width="40" Height="25"
                          IsEnabled="False"
                          Margin="0,0,5,0">
                <TextBlock Text="AZ" FontWeight="Bold" FontSize="11"/>
            </ToggleButton>

            <TextBox x:Name="txtSearch"
                     Grid.Column="1"
                     Height="25"
                     VerticalContentAlignment="Center"/>
        </Grid>

        <!-- Liste (CheckBoxes créées en Python) -->
        <ListBox x:Name="lstSchedules"
                 Grid.Row="2"
                 Margin="10,0,10,5"
                 SelectionMode="Single"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>

        <!-- Boutons de sélection en masse -->
        <Grid Grid.Row="3" Margin="10,0,10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnCheckAll"
                    Grid.Column="0"
                    Content="Tout sélectionner"
                    Style="{StaticResource BoutonAction}"
                    Margin="0,0,2,0"/>
            <Button x:Name="btnUncheckAll"
                    Grid.Column="1"
                    Content="Tout désélectionner"
                    Style="{StaticResource BoutonAction}"
                    Margin="2,0,2,0"/>
            <Button x:Name="btnToggleAll"
                    Grid.Column="2"
                    Content="Inverser"
                    Style="{StaticResource BoutonAction}"
                    Margin="2,0,0,0"/>
        </Grid>

        <!-- Bouton Appliquer -->
        <Button x:Name="btnOk"
                Grid.Row="4"
                Content="Appliquer les couleurs"
                Style="{StaticResource BoutonAppliquer}"
                Margin="10,0,10,10"
                IsDefault="True"/>
    </Grid>
</Window>
