<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copier des paramètres — Étape 2 / 2 : Destinations et position"
        Height="680" Width="780"
        MinHeight="480" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Bandeau info -->
            <RowDefinition Height="Auto"/>   <!-- Instruction -->
            <RowDefinition Height="*"/>      <!-- Deux colonnes -->
            <RowDefinition Height="Auto"/>   <!-- Boutons sélection -->
            <RowDefinition Height="Auto"/>   <!-- Validation inline -->
            <RowDefinition Height="Auto"/>   <!-- Appliquer -->
        </Grid.RowDefinitions>

        <!-- Bandeau info source / paramètres -->
        <Border Grid.Row="0" Margin="0,0,0,8" Padding="10,7"
                CornerRadius="4" Background="#EFF6FF"
                BorderBrush="#BFDBFE" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="SemiBold"
                           Text="Source : " VerticalAlignment="Center" Margin="0,0,4,2"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtSourceName"
                           Text="—" VerticalAlignment="Center" Margin="0,0,0,2"/>
                <TextBlock Grid.Row="1" Grid.Column="0" FontWeight="SemiBold"
                           Text="Paramètres : " VerticalAlignment="Top" Margin="0,0,4,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtFieldName"
                           Text="—" TextWrapping="Wrap" FontStyle="Italic"/>
            </Grid>
        </Border>

        <!-- Instruction -->
        <TextBlock Grid.Row="1" Margin="0,0,0,8" TextWrapping="Wrap" FontSize="13">
            <Run FontWeight="SemiBold" Text="Étape 2 / 2 — "/>
            <Run Text="Sélectionnez les nomenclatures cibles et définissez la position."/>
        </TextBlock>

        <!-- Deux colonnes -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- GAUCHE : destinations -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" FontWeight="SemiBold" FontSize="12"
                           Margin="0,0,0,5" Text="Nomenclatures cibles"/>
                <Grid Grid.Row="1" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="0" Width="36" Height="25"
                                  IsEnabled="False" Margin="0,0,4,0">
                        <TextBlock Text="AZ" FontWeight="Bold" FontSize="11"/>
                    </ToggleButton>
                    <TextBox x:Name="txtSearch" Grid.Column="1" Height="25"
                             VerticalContentAlignment="Center"/>
                </Grid>
                <ListBox x:Name="lstSchedules" Grid.Row="2"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </Grid>

            <!-- Séparateur -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="#DDDDDD" ShowsPreview="True"/>

            <!-- DROITE : position -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" FontWeight="SemiBold" FontSize="12"
                           Margin="0,0,0,5" Text="Position du paramètre"/>
                <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1"
                        CornerRadius="4" Padding="12,10">
                    <StackPanel>
                        <RadioButton x:Name="rbFirst" Content="En première position"
                                     GroupName="Position" Margin="0,0,0,8"/>
                        <RadioButton x:Name="rbLast" Content="En dernière position"
                                     GroupName="Position" IsChecked="True" Margin="0,0,0,16"/>
                        <Separator Margin="0,0,0,12" Background="#DDDDDD"/>
                        <RadioButton x:Name="rbAfter" Content="Après le paramètre :"
                                     GroupName="Position" Margin="0,0,0,6"/>
                        <RadioButton x:Name="rbBefore" Content="Avant le paramètre :"
                                     GroupName="Position" Margin="0,0,0,8"/>
                        <ComboBox x:Name="cboRefField" Height="26" IsEnabled="False"
                                  VerticalContentAlignment="Center" Margin="0,0,0,0"/>
                        <TextBlock x:Name="txtRefHint"
                                   Text="Sélectionnez d'abord&#x0a;« Après » ou « Avant »"
                                   FontSize="11" Foreground="#888888"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Boutons sélection destinations -->
        <Grid Grid.Row="3" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="btnCheckAll" Grid.Column="0"
                        Content="Tout sélectionner"
                        Style="{DynamicResource NMButtonStandard}"
                        Height="30" Margin="0,0,2,0"/>
                <Button x:Name="btnUncheckAll" Grid.Column="1"
                        Content="Tout désélectionner"
                        Style="{DynamicResource NMButtonStandard}"
                        Height="30" Margin="2,0,2,0"/>
                <Button x:Name="btnToggleAll" Grid.Column="2"
                        Content="Inverser"
                        Style="{DynamicResource NMButtonStandard}"
                        Height="30" Margin="2,0,0,0"/>
            </Grid>
        </Grid>

        <!-- Message de validation inline -->
        <Border Grid.Row="4" x:Name="borderValidation"
                Margin="0,8,0,0" Padding="10,6"
                Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                CornerRadius="4" Visibility="Collapsed">
            <TextBlock x:Name="txtValidation"
                       Foreground="#DC2626" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </Border>

        <!-- Bouton Appliquer -->
        <!-- Pied de dialogue standard NM-BATII : proportions * | 8 | 130 -->
        <Grid Grid.Row="5" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="btnOk"
                    Content="▶  Appliquer"
                    Style="{DynamicResource NMButtonAppliquer}"
                    IsDefault="True"/>
            <Button Grid.Column="2" x:Name="btnCancel"
                    Content="Annuler"
                    Style="{DynamicResource NMButtonAnnuler}"
                    IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
