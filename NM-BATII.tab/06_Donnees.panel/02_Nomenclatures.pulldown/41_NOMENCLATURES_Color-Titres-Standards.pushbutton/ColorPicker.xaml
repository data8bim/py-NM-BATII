<!-- ColorPicker.xaml
     Place this file next to script.py (UTF-8)
     Onglet "Standards" + onglet "Couleurs personnalisées"
     Boutons Appliquer / Annuler fixes en bas, visibles pour les deux onglets
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sélection de la couleur"
        Width="500" Height="550"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>    <!-- TabControl -->
            <RowDefinition Height="Auto"/> <!-- Boutons en bas -->
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">

            <!-- Onglet 1 : Standards Nantes Métropole -->
            <TabItem Header="Standards Nantes Métropole">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel x:Name="standards_panel" />
                </ScrollViewer>
            </TabItem>

            <!-- Onglet 2 : Couleurs personnalisées (UI existante) -->
            <TabItem Header="Couleurs personnalisées">
                <Grid Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Choisissez une couleur d'ombrage"
                               FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="colors_panel">
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" BorderBrush="#CCC" BorderThickness="1"
                            Background="White" CornerRadius="3" Padding="15" Margin="0,15,0,15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Couleur personnalisée (RGB)"
                                       FontWeight="SemiBold" Margin="0,0,0,10"/>

                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Rouge:" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="red_slider" Minimum="0" Maximum="255"
                                        Value="200" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                <TextBox Grid.Column="2" x:Name="red_text" Text="200"
                                         Margin="5,0,0,0" Padding="3" TextAlignment="Center"/>
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Vert:" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="green_slider" Minimum="0" Maximum="255"
                                        Value="220" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                <TextBox Grid.Column="2" x:Name="green_text" Text="220"
                                         Margin="5,0,0,0" Padding="3" TextAlignment="Center"/>
                            </Grid>

                            <Grid Grid.Row="3" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Bleu:" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="blue_slider" Minimum="0" Maximum="255"
                                        Value="255" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                <TextBox Grid.Column="2" x:Name="blue_text" Text="255"
                                         Margin="5,0,0,0" Padding="3" TextAlignment="Center"/>
                            </Grid>

                            <Border Grid.Row="4" x:Name="custom_preview" Height="40"
                                    BorderBrush="#888" BorderThickness="2" CornerRadius="3"
                                    Background="#C8DCFF" Margin="0,5,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- Boutons fixes en bas, visibles pour tous les onglets -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="ok_button" Content="Appliquer"
                    Width="100" Height="35" Margin="0,0,10,0"
                    Background="#0078D4" Foreground="White"
                    BorderThickness="0" FontWeight="Bold"
                    IsDefault="True"/>
            <Button x:Name="cancel_button" Content="Annuler"
                    Width="100" Height="35"
                    Background="#E0E0E0" Foreground="Black"
                    BorderThickness="1" BorderBrush="#AAA"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
