<?xml version="1.0" encoding="utf-8"?>
<!--
  SurfacesProjetDialog.xaml — Tableau « Surfaces du projet » de
  21_MAPP_SP-SHON-SHOB, commun aux deux methodes (calculs et imports) et
  presente AVANT ecriture (les transactions Revit ne se defont pas par Ctrl+Z
  une fois commitees).

  Un niveau par ligne, une colonne par parametre de surface, puis une ligne de
  totaux. Les valeurs que le script modifie sont affichees en rouge.

  Le groupe « Auteur des calculs de surfaces » en tete de fenetre remplace
  l'ancienne fenetre AuteurCalculsDialog.xaml : entreprise + qualification y
  sont saisies avant d'appliquer.

  Methode par imports : les cellules des niveaux importes sont des zones de
  saisie, l'utilisateur corrige avant ecriture ; totaux et mises en rouge se
  recalculent a la volee. Methode par calculs : cellules en lecture seule.

  Le tableau est un empilement de Border construit cote Python (headerHost /
  rowsPanel / totalHost), comme lib/dialogs/mapping_table.py : aucun binding ni
  convertisseur a ecrire.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Surfaces du projet"
        Width="760"
        MinWidth="760"
        Height="620"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <Window.Resources>
    <Style TargetType="TextBox"  BasedOn="{StaticResource NMTextBoxStandard}"/>
    <Style TargetType="ComboBox" BasedOn="{StaticResource NMComboBoxStandard}"/>
    <!-- FontSize 12 : meme reduction que MainWindow.xaml de
         01_MODIFIER_Selection-Epinglage, pour des cases de filtre plus
         compactes. -->
    <Style TargetType="CheckBox" BasedOn="{StaticResource NMCheckBoxStandard}">
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </Window.Resources>

  <!-- Ecarts entre rangees resserres a 8/8/8 (au lieu de 10/10/12), comme
       MainWindow.xaml de 01_MODIFIER_Selection-Epinglage : la rangee 5
       (tableau, hauteur "*") en profite directement. -->
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- 0 : auteur des calculs -->
      <RowDefinition Height="8"/>
      <RowDefinition Height="Auto"/>   <!-- 2 : filtres par type de niveau -->
      <RowDefinition Height="6"/>
      <RowDefinition Height="Auto"/>   <!-- 4 : en-tete du tableau -->
      <RowDefinition Height="*"/>      <!-- 5 : lignes (defilantes) -->
      <RowDefinition Height="Auto"/>   <!-- 6 : ligne de totaux -->
      <RowDefinition Height="8"/>
      <RowDefinition Height="Auto"/>   <!-- 8 : echanges tableur -->
      <RowDefinition Height="8"/>
      <RowDefinition Height="Auto"/>   <!-- 10 : legende -->
      <RowDefinition Height="8"/>
      <RowDefinition Height="Auto"/>   <!-- 12 : pied -->
    </Grid.RowDefinitions>

    <!-- Declaration de l'auteur : anciennement une fenetre a part
         (AuteurCalculsDialog.xaml), fusionnee ici pour que l'utilisateur voie
         du meme coup qui signe et ce qui est signe. Les champs sont
         pre-remplis depuis « Nom de l'organisation » des informations projet ;
         les corriger ne modifie pas le projet. -->
    <GroupBox x:Name="grpAuteur" Grid.Row="0"
              Header="Auteur des calculs de surfaces">
      <Grid Margin="6,2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="4"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="Entreprise" VerticalAlignment="Center"
                   Foreground="#333333"/>
        <!-- Padding local reduit (NMTextBoxStandard en met 6 de chaque cote) :
             ce champ n'a besoin que d'une ligne, inutile de lui laisser la
             meme hauteur qu'un champ de saisie multiligne. -->
        <TextBox   Grid.Row="0" Grid.Column="1"
                   x:Name="txtEntreprise" VerticalAlignment="Center"
                   Padding="6,3"/>

        <TextBlock Grid.Row="0" Grid.Column="3"
                   Text="Qualification" VerticalAlignment="Center"
                   Foreground="#333333"/>
        <ComboBox  Grid.Row="0" Grid.Column="4"
                   x:Name="cmbQualification" VerticalAlignment="Center"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5"
                   x:Name="txtApercuAuteur"
                   TextWrapping="Wrap"
                   Foreground="#666666"/>
      </Grid>
    </GroupBox>

    <!-- Filtres par type de niveau (Batiment - R, Toiture - T…), construits en
         Python depuis les prefixes declares dans Parametres -> Niveaux, comme
         dans la fenetre d'export. Ils ne masquent que l'AFFICHAGE : les totaux
         restent calcules sur tous les niveaux du batiment. -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0"
                 Text="Afficher :" VerticalAlignment="Center"
                 Margin="2,0,8,0" Foreground="#333333"/>
      <!-- VerticalAlignment="Center" : sans cet attribut le WrapPanel
           s'etire (Stretch par defaut) sur la hauteur de la rangee — imposee
           par le bouton, plus haut que les cases — et ses cases restent
           ancrees en haut, desalignees du libelle et du bouton. -->
      <WrapPanel x:Name="pnlFiltresTypes"
                 Grid.Column="1"
                 VerticalAlignment="Center"
                 Orientation="Horizontal"/>
      <!-- Libelle et visibilite poses en Python : le bouton n'apparait que
           s'il existe des valeurs hors perimetre a remettre a zero. Style
           NMButtonStandard (bouton neutre, meme apparence que
           "Réinitialiser les colonnes" du dialogue Selection/Epinglage) :
           il ne concurrence pas visuellement Appliquer/Annuler du pied.
           Margin="0" : sans lui NMButtonStandard applique sa marge de 4 px
           et le bouton deborde la hauteur des cases a cocher (cf. convention
           "Rangee d'actions de meme largeur"). -->
      <Button x:Name="btnZeroHorsSource"
              Grid.Column="3"
              VerticalAlignment="Center"
              Margin="0"
              Padding="8,2"
              Style="{DynamicResource NMButtonStandard}"/>
    </Grid>

    <!-- En-tete : hors du ScrollViewer pour rester visible au defilement.
         La marge droite reservee a la barre de defilement est posee en Python
         (SystemParameters.VerticalScrollBarWidth), sinon les colonnes de
         l'en-tete et celles des lignes ne coincident pas. -->
    <Border x:Name="headerHost"
            Grid.Row="4"
            Background="#1E90FF"
            BorderBrush="#444444"
            BorderThickness="1"/>

    <ScrollViewer Grid.Row="5"
                  VerticalScrollBarVisibility="Visible"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="rowsPanel"/>
    </ScrollViewer>

    <Border x:Name="totalHost"
            Grid.Row="6"
            Background="#EFEFEF"
            BorderBrush="#444444"
            BorderThickness="1"/>

    <!-- Echanges tableur : l'export part des valeurs actuellement affichees
         (nomenclatures + saisies en cours), l'import ne renseigne que les
         cellules non calculees — les nomenclatures ont priorite. Les deux
         boutons agissent sur le tableau sans fermer la fenetre, d'ou le style
         neutre NMButtonStandard plutot qu'un style de pied de dialogue. -->
    <Grid Grid.Row="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button x:Name="btnExport"
              Grid.Column="1"
              Content="Exporter vers un tableur (.xlsx)..."
              Margin="0" Padding="8,3"
              Style="{DynamicResource NMButtonStandard}"/>
      <Button x:Name="btnImport"
              Grid.Column="3"
              Content="Importer un tableur renseigné (.xlsx)..."
              Margin="0" Padding="8,3"
              Style="{DynamicResource NMButtonStandard}"/>
    </Grid>

    <!-- Legende posee en Python : elle depend des cellules reellement
         presentes (calculees, saisissables, modifiees). -->
    <TextBlock x:Name="txtLegende"
               Grid.Row="10"
               Margin="2,0"
               TextWrapping="Wrap"
               Foreground="#666666"/>

    <Grid Grid.Row="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="130"/>
      </Grid.ColumnDefinitions>
      <Button x:Name="btnApply"
              Grid.Column="0"
              Content="&#x25B6;  Appliquer"
              HorizontalAlignment="Stretch"
              IsDefault="True"
              Style="{DynamicResource NMButtonAppliquer}"/>
      <Button x:Name="btnCancel"
              Grid.Column="2"
              Content="Annuler"
              Style="{DynamicResource NMButtonAnnuler}"
              IsCancel="True"
              VerticalAlignment="Center"/>
    </Grid>

  </Grid>
</Window>
