<?xml version="1.0" encoding="utf-8"?>
<!-- Sélection UNIQUE, d'où une ListBox et non une pile de cases à cocher :
     une seule position sert de modèle, en proposer plusieurs n'aurait pas de
     sens et obligerait à arbitrer après coup. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NM-BATII — Vue de référence"
        Width="620" Height="520"
        MinWidth="480" MinHeight="360"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">

  <Window.Resources>
    <Style TargetType="TextBlock" BasedOn="{StaticResource NMTextBlockStandard}"/>
    <Style TargetType="Button"    BasedOn="{StaticResource NMButtonStandard}"/>
    <Style TargetType="TextBox"   BasedOn="{StaticResource NMTextBoxStandard}"/>
  </Window.Resources>

  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="10"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" TextWrapping="Wrap" FontSize="12" Foreground="#555555"
               Text="Seuls les plans de surface portant déjà une légende sont listés. Sa position sera reprise telle quelle sur toutes les vues traitées, quel que soit leur type de calcul."/>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Contient" VerticalAlignment="Center"/>
      <TextBox Grid.Column="2" x:Name="txtSearch"/>
    </Grid>

    <Border Grid.Row="4" BorderThickness="1" BorderBrush="LightGray">
      <ListBox x:Name="lstViews" BorderThickness="0"
               SelectionMode="Single" FontSize="12"/>
    </Border>

    <Grid Grid.Row="6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="130"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" x:Name="btnOk"
              Content="▶  Utiliser cette vue"
              Style="{DynamicResource NMButtonAppliquer}"
              IsDefault="True"/>
      <Button Grid.Column="2" x:Name="btnCancel"
              Content="Annuler"
              Style="{DynamicResource NMButtonAnnuler}"
              IsCancel="True"/>
    </Grid>
  </Grid>
</Window>
