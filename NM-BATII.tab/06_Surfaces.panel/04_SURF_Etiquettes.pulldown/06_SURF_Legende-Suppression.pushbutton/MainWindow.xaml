<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NM-BATII — Supprimer les légendes de motif/couleur"
        Width="560" Height="520"
        MinWidth="440" MinHeight="420"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <Style TargetType="TextBlock" BasedOn="{StaticResource NMTextBlockStandard}"/>
    <Style TargetType="ComboBox"  BasedOn="{StaticResource NMComboBoxStandard}"/>
    <Style TargetType="Button"    BasedOn="{StaticResource NMButtonStandard}"/>
    <Style TargetType="CheckBox"  BasedOn="{StaticResource NMCheckBoxStandard}">
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </Window.Resources>

  <!-- Hauteur fixe et liste des types en "*", contrairement au dialogue de
       pose : ici c'est la liste qui doit absorber la place disponible, sa
       longueur dépendant du projet. -->
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="10"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="12"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" TextWrapping="Wrap" FontSize="12" Foreground="#555555"
               Text="Seuls les plans de surface sont concernés : une légende posée sur un plan d'étage n'est jamais supprimée."/>

    <!-- ═══ Types de légende ═══════════════════════════════════════════════ -->
    <GroupBox Grid.Row="2" Header="Types de légende en place (sélection multiple)">
      <Grid Margin="4,4,4,6">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="6"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button Grid.Row="0" x:Name="btnDeselectAll"
                Content="Tout désélectionner"
                HorizontalAlignment="Left" Width="160"/>
        <Border Grid.Row="2" BorderThickness="1" BorderBrush="LightGray">
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="spTypes"/>
          </ScrollViewer>
        </Border>
      </Grid>
    </GroupBox>

    <!-- ═══ Portée du traitement ═══════════════════════════════════════════ -->
    <GroupBox Grid.Row="4" Header="Portée du traitement">
      <StackPanel Margin="4,4,4,6">
        <RadioButton x:Name="rbToutes"
                     GroupName="portee" Margin="0,4" IsChecked="True"
                     Content="Tous les plans de surface"
                     ToolTip="Tous les plans de surface du projet, hors gabarits."/>
        <StackPanel Orientation="Horizontal" Margin="0,4">
          <RadioButton x:Name="rbSchemas"
                       GroupName="portee" VerticalAlignment="Center"
                       Content="Par schéma de surface"
                       ToolTip="Les plans de surface des schémas cochés (SHON/SHOB, Surface Plancher...)."/>
          <Button x:Name="btnSelectSchemas" Content="Choisir les schémas..."
                  Margin="8,0,0,0" Padding="8,2"/>
          <TextBlock x:Name="txtSchemasCount" Margin="8,0,0,0"
                     VerticalAlignment="Center" FontSize="12"
                     Text="(0 schéma)"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,4">
          <RadioButton x:Name="rbVues"
                       GroupName="portee" VerticalAlignment="Center"
                       Content="Par vues sélectionnées"
                       ToolTip="Les seuls plans de surface cochés dans le tableau."/>
          <Button x:Name="btnSelectViews" Content="Choisir les vues..."
                  Margin="8,0,0,0" Padding="8,2"/>
          <TextBlock x:Name="txtViewsCount" Margin="8,0,0,0"
                     VerticalAlignment="Center" FontSize="12"
                     Text="(0 vue)"/>
        </StackPanel>
      </StackPanel>
    </GroupBox>

    <!-- ═══ Boutons d'action ═══════════════════════════════════════════════ -->
    <Grid Grid.Row="6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="130"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" x:Name="btnOK"
              Content="▶  Supprimer"
              Style="{DynamicResource NMButtonAppliquer}"
              IsDefault="True"/>
      <Button Grid.Column="2" x:Name="btnCancel"
              Content="Annuler"
              Style="{DynamicResource NMButtonAnnuler}"
              IsCancel="True"/>
    </Grid>
  </Grid>
</Window>
