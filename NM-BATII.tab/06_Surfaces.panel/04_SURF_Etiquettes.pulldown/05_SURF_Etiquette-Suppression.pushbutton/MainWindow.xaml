<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NM-BATII — Supprimer les étiquettes de surfaces en masse"
        Width="780" Height="640"
        MinWidth="600" MinHeight="520"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <Style TargetType="TextBlock" BasedOn="{StaticResource NMTextBlockStandard}"/>
    <Style TargetType="ComboBox"  BasedOn="{StaticResource NMComboBoxStandard}"/>
    <Style TargetType="Button"    BasedOn="{StaticResource NMButtonStandard}"/>
    <Style TargetType="CheckBox"  BasedOn="{StaticResource NMCheckBoxStandard}">
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </Window.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="10"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="12"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ═══ Types d'étiquette ══════════════════════════════════════════════ -->
    <GroupBox Grid.Row="0" Header="Types d'étiquette de surface (sélection multiple)">
      <Grid Margin="4,4,4,6">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="6"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button Grid.Row="0" x:Name="btnDeselectAll"
                Content="Tout désélectionner"
                HorizontalAlignment="Left" Width="160"/>
        <Border Grid.Row="2" BorderThickness="1" BorderBrush="LightGray">
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="spTagTypes"/>
          </ScrollViewer>
        </Border>
      </Grid>
    </GroupBox>

    <!-- ═══ Portée du traitement ═══════════════════════════════════════════ -->
    <GroupBox Grid.Row="2" Header="Portée du traitement">
      <StackPanel Margin="4,4,4,6">
        <RadioButton x:Name="rbProjetToutes"
                     GroupName="portee" Margin="0,4"
                     Content="Dans tous les plans de surface : Toutes les étiquettes"/>
        <StackPanel Orientation="Horizontal" Margin="0,4">
          <RadioButton x:Name="rbProjetSelection"
                       GroupName="portee" VerticalAlignment="Center"
                       Content="Dans tous les plans de surface : Toutes les étiquettes des surfaces sélectionnées"/>
          <Button x:Name="btnSelectAreasProjet" Content="Sélectionner"
                  Margin="8,0,0,0" Padding="8,2"/>
          <TextBlock x:Name="txtSelectionCountProjet" Margin="8,0,0,0"
                     VerticalAlignment="Center" FontSize="12"
                     Text="(0 surface sélectionnée)"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,4">
          <RadioButton x:Name="rbVuesSelectionneesToutes"
                       GroupName="portee" VerticalAlignment="Center"
                       Content="Dans les vues sélectionnées : Toutes les étiquettes"/>
          <Button x:Name="btnSelectViews" Content="Choisir les vues..."
                  Margin="8,0,0,0" Padding="8,2"/>
          <TextBlock x:Name="txtViewsCount" Margin="8,0,0,0"
                     VerticalAlignment="Center" FontSize="12"
                     Text="(0 vue sélectionnée)"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,4">
          <RadioButton x:Name="rbVuesSelectionneesAreas"
                       GroupName="portee" VerticalAlignment="Center"
                       Content="Dans les vues sélectionnées : Étiquettes des surfaces sélectionnées"/>
          <Button x:Name="btnSelectViews2" Content="Choisir les vues..."
                  Margin="8,0,0,0" Padding="8,2"/>
          <TextBlock x:Name="txtViewsCount2" Margin="8,0,0,0"
                     VerticalAlignment="Center" FontSize="12"
                     Text="(0 vue sélectionnée)"/>
          <Button x:Name="btnSelectAreasVues" Content="Sélectionner"
                  Margin="8,0,0,0" Padding="8,2"/>
          <TextBlock x:Name="txtSelectionCountVues" Margin="8,0,0,0"
                     VerticalAlignment="Center" FontSize="12"
                     Text="(0 surface sélectionnée)"/>
        </StackPanel>
        <RadioButton x:Name="rbVueToutes"
                     GroupName="portee" Margin="0,4" IsChecked="True"
                     Content="Dans la vue active : Toutes les étiquettes"/>
        <StackPanel Orientation="Horizontal" Margin="0,4">
          <RadioButton x:Name="rbVueSelection"
                       GroupName="portee" VerticalAlignment="Center"
                       Content="Dans la vue active : Étiquettes des surfaces sélectionnées"/>
          <Button x:Name="btnSelectAreas" Content="Sélectionner"
                  Margin="8,0,0,0" Padding="8,2"/>
          <TextBlock x:Name="txtSelectionCount" Margin="8,0,0,0"
                     VerticalAlignment="Center" FontSize="12"
                     Text="(0 surface sélectionnée)"/>
        </StackPanel>
      </StackPanel>
    </GroupBox>

    <!-- ═══ Boutons d'action ═══════════════════════════════════════════════ -->
    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="130"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" x:Name="btnOK"
              Content="▶  Supprimer"
              Style="{DynamicResource NMButtonAppliquer}"
              IsDefault="True"/>
      <Button Grid.Column="2" x:Name="btnCancel"
              Content="Annuler"
              Style="{DynamicResource NMButtonAnnuler}"
              IsCancel="True"/>
    </Grid>
  </Grid>
</Window>
