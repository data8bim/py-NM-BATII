<?xml version="1.0" encoding="utf-8"?>
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Créer des bases de nomenclatures"
    Width="920" Height="680"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResize">

  <Window.Resources>
    <!-- Fallbacks locaux -->
    <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFF" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#FFDDDDDD" />
    <SolidColorBrush x:Key="PanelTitleBrush" Color="#FF222222" />

    <!-- Styles pour les boutons d'action -->
    <Style x:Key="BoutonAction" TargetType="Button" BasedOn="{StaticResource NMButtonStandard}">
      <Setter Property="Height" Value="30"/>
    </Style>
    
    <!-- Style pour le bouton Appliquer -->
    <!-- Style pour le bouton Annuler (aussi NMButtonValide - vert) -->
  </Window.Resources>

  <Grid Margin="12" Background="{DynamicResource DialogBackgroundBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="2.0*" />
      <ColumnDefinition Width="1.6*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- LEFT COLUMN: Categories -->
    <Grid Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Margin="0,0,12,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      
      <!-- Titre -->
      <TextBlock Grid.Row="0" 
                 Text="Catégories des nomenclatures à créer"
                 FontSize="14" FontWeight="Bold" Margin="0,0,0,8" 
                 Foreground="{DynamicResource PanelTitleBrush}" />
      
      <!-- Zone de recherche -->
      <Grid Grid.Row="1" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Bouton AZ (désactivé) -->
        <ToggleButton x:Name="btnSearchMode" 
                      Grid.Column="0"
                      Width="40" 
                      Height="25"
                      IsEnabled="False"
                      Margin="0,0,5,0">
          <TextBlock Text="AZ" 
                     FontWeight="Bold"
                     FontSize="11"/>
        </ToggleButton>
        
        <!-- Zone de recherche -->
        <TextBox x:Name="txtSearchCategories" 
                 Grid.Column="1"
                 Height="25"
                 VerticalContentAlignment="Center"/>
      </Grid>
      
      <!-- Liste -->
      <Border Grid.Row="2" 
              Background="{DynamicResource PanelBackgroundBrush}" 
              Padding="8" CornerRadius="4" 
              BorderBrush="{DynamicResource PanelBorderBrush}" 
              BorderThickness="1">
        <ListBox x:Name="categories_panel" 
                 SelectionMode="Extended" 
                 BorderThickness="0" 
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
      </Border>

      <!-- Boutons -->
      <Grid Grid.Row="3" Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button x:Name="btn_check_cat" Content="Tout sélectionner" 
                Grid.Column="0" HorizontalAlignment="Stretch" 
                Margin="2,0" Style="{StaticResource BoutonAction}" />
        <Button x:Name="btn_uncheck_cat" Content="Tout désélectionner" 
                Grid.Column="1" HorizontalAlignment="Stretch" 
                Margin="2,0" Style="{StaticResource BoutonAction}" />
        <Button x:Name="btn_toggle_cat" Content="Inverser" 
                Grid.Column="2" HorizontalAlignment="Stretch" 
                Margin="2,0" Style="{StaticResource BoutonAction}" />
      </Grid>
    </Grid>

    <!-- RIGHT COLUMN: Types et Phases -->
    <Grid Grid.Column="1" Grid.Row="0" Grid.RowSpan="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="1.2*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      
      <!-- Types - Titre -->
      <TextBlock Grid.Row="0" 
                 Text="Type de nomenclatures à créer" 
                 FontSize="13" FontWeight="Bold" Margin="0,0,0,6" 
                 Foreground="{DynamicResource PanelTitleBrush}" />
      
      <!-- Types - Liste (1.2* de l'espace) -->
      <Border Grid.Row="1" 
              Background="{DynamicResource PanelBackgroundBrush}" 
              Padding="8" CornerRadius="4" 
              BorderBrush="{DynamicResource PanelBorderBrush}" 
              BorderThickness="1">
        <ListBox x:Name="types_panel" 
                 SelectionMode="Extended" 
                 BorderThickness="0" 
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
      </Border>

      <!-- Types - Boutons -->
      <Grid Grid.Row="2" Margin="0,8,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button x:Name="btn_check_types" Content="Tout sélectionner" 
                Grid.Column="0" HorizontalAlignment="Stretch" 
                Margin="2,0" Style="{StaticResource BoutonAction}" />
        <Button x:Name="btn_uncheck_types" Content="Tout désélectionner" 
                Grid.Column="1" HorizontalAlignment="Stretch" 
                Margin="2,0" Style="{StaticResource BoutonAction}" />
        <Button x:Name="btn_toggle_types" Content="Inverser" 
                Grid.Column="2" HorizontalAlignment="Stretch" 
                Margin="2,0" Style="{StaticResource BoutonAction}" />
      </Grid>

      <!-- Phases - Titre -->
      <TextBlock Grid.Row="3" 
                 Text="Phases des nomenclatures à créer" 
                 FontSize="13" FontWeight="Bold" Margin="0,6,0,6" 
                 Foreground="{DynamicResource PanelTitleBrush}" />
      
      <!-- Phases - Liste (1* de l'espace) -->
      <Border Grid.Row="4" 
              Background="{DynamicResource PanelBackgroundBrush}" 
              Padding="8" CornerRadius="4" 
              BorderBrush="{DynamicResource PanelBorderBrush}" 
              BorderThickness="1">
        <ListBox x:Name="phases_panel" 
                 SelectionMode="Extended" 
                 BorderThickness="0" 
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
      </Border>

      <!-- Phases - Boutons -->
      <Grid Grid.Row="5" Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button x:Name="btn_check_phases" Content="Tout sélectionner" 
                Grid.Column="0" HorizontalAlignment="Stretch" 
                Margin="2,0" Style="{StaticResource BoutonAction}" />
        <Button x:Name="btn_uncheck_phases" Content="Tout désélectionner" 
                Grid.Column="1" HorizontalAlignment="Stretch" 
                Margin="2,0" Style="{StaticResource BoutonAction}" />
        <Button x:Name="btn_toggle_phases" Content="Inverser" 
                Grid.Column="2" HorizontalAlignment="Stretch" 
                Margin="2,0" Style="{StaticResource BoutonAction}" />
      </Grid>
    </Grid>

    <!-- Nomenclature modèle (SOURCE) - OPTIONNEL -->
    <!-- Champ déroulant avec recherche intégrée : un clic ouvre un Popup
         contenant le filtre en haut et la liste en dessous. Un ComboBox
         standard ne permet pas de loger une zone de saisie dans sa liste, et
         un ComboBox IsEditable annulerait SelectedItem à chaque frappe. -->
    <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0"
                 Text="Nomenclature modèle (optionnel) :"
                 VerticalAlignment="Center"
                 Margin="0,0,10,0"
                 FontSize="12"
                 FontWeight="SemiBold"/>

      <!-- Le ToggleButton joue le rôle du champ fermé. Son IsChecked pilote
           l'ouverture du Popup dans les deux sens : cliquer ailleurs ferme le
           Popup (StaysOpen=False) et décoche donc le bouton. -->
      <ToggleButton x:Name="btn_source"
                    Grid.Column="1"
                    Height="30"
                    Padding="8,0"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Center">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="txt_source_value"
                     Grid.Column="0"
                     Text="-- Aucune (créer sans configuration) --"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Left"
                     TextTrimming="CharacterEllipsis"/>
          <TextBlock Grid.Column="1"
                     Text="&#x25BC;"
                     FontSize="9"
                     Margin="8,0,0,0"
                     VerticalAlignment="Center"
                     Foreground="Gray"/>
        </Grid>
      </ToggleButton>

      <Popup x:Name="popup_source"
             Grid.Column="1"
             PlacementTarget="{Binding ElementName=btn_source}"
             Placement="Bottom"
             StaysOpen="False"
             AllowsTransparency="True"
             PopupAnimation="Fade"
             IsOpen="{Binding IsChecked, ElementName=btn_source, Mode=TwoWay}">
        <Border Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="1"
                Padding="6">
          <Grid Width="{Binding ActualWidth, ElementName=btn_source}"
                MinWidth="320">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBox x:Name="txtSearchSource"
                     Grid.Row="0"
                     Height="26"
                     VerticalContentAlignment="Center"
                     ToolTip="Filtrer : n'affiche que les nomenclatures dont le nom contient le texte saisi. Entrée sélectionne le 1er résultat, Échap ferme."/>

            <TextBlock x:Name="txtSourceCount"
                       Grid.Row="1"
                       Margin="2,4,0,4"
                       FontSize="11"
                       Foreground="Gray"/>

            <ListBox x:Name="list_source"
                     Grid.Row="2"
                     MaxHeight="260"
                     BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
          </Grid>
        </Border>
      </Popup>
    </Grid>

    <!-- Pied de dialogue standard NM-BATII : proportions * | 8 | 130 -->
    <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="130"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" x:Name="btn_ok"
              Content="▶  Appliquer"
              Style="{DynamicResource NMButtonAppliquer}"
              IsDefault="True"/>
      <Button Grid.Column="2" x:Name="btn_cancel"
              Content="Annuler"
              Style="{DynamicResource NMButtonAnnuler}"
              IsCancel="True"/>
    </Grid>
  </Grid>
</Window>