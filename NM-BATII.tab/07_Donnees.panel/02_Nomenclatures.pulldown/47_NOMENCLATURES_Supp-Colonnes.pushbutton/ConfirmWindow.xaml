<?xml version="1.0" encoding="utf-8"?>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmation"
        SizeToContent="WidthAndHeight"
        MinWidth="460" MaxWidth="600"
        MaxHeight="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Window" BasedOn="{StaticResource NMWindowStandard}" />
        <Style TargetType="TextBlock" BasedOn="{StaticResource NMTextBlockStandard}" />
    </Window.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Icône + message principal -->
            <RowDefinition Height="Auto"/>   <!-- Résumé paramètres avec ascenseur -->
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>   <!-- Boutons -->
        </Grid.RowDefinitions>

        <!-- Zone avertissement -->
        <Border Grid.Row="0"
                BorderBrush="#EA580C" BorderThickness="1"
                CornerRadius="3" Padding="12,10" Margin="5,5,5,0">
            <StackPanel>
                <!-- Titre -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="⚠" FontSize="20" Foreground="#EA580C"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Cette action est irréversible."
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="#EA580C" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- Message -->
                <TextBlock x:Name="txtMessage"
                           TextWrapping="Wrap" FontSize="13"/>
            </StackPanel>
        </Border>

        <!-- Résumé des paramètres avec ascenseur -->
        <Border Grid.Row="1"
                BorderBrush="#DDDDDD" BorderThickness="1"
                CornerRadius="3" Margin="5,6,5,0">
            <StackPanel>
                <TextBlock Text="Paramètres concernés :"
                           FontWeight="SemiBold" FontSize="12"
                           Margin="8,6,8,4"/>
                <ScrollViewer MaxHeight="200"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="txtSummary"
                               TextWrapping="Wrap" FontSize="12"
                               Foreground="#374151"
                               Margin="8,0,8,8"/>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Boutons Annuler / Supprimer -->
        <Grid Grid.Row="3" Margin="5,0,5,5">
            <!-- Pied de dialogue standard NM-BATII : proportions * | 8 | 130 -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnConfirm" Grid.Column="0"
                    Content="▶  Supprimer"
                    Style="{DynamicResource NMButtonAppliquer}"
                    IsDefault="True"/>
            <Button x:Name="btnCancel" Grid.Column="2"
                    Content="Annuler"
                    Style="{DynamicResource NMButtonAnnuler}"
                    IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
