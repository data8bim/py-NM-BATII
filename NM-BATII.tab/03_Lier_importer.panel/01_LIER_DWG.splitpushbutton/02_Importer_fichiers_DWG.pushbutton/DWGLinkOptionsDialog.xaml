<?xml version="1.0" encoding="utf-8"?>

<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Lier DWG aux vues"
    SizeToContent="WidthAndHeight"
    MinWidth="500"
    MaxWidth="700"
    MinHeight="400"
    MaxHeight="600"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <Style TargetType="Window" BasedOn="{StaticResource NMWindowStandard}" />
        <Style TargetType="TextBlock" BasedOn="{StaticResource NMTextBlockStandard}" />
        <Style TargetType="Button" BasedOn="{StaticResource NMButtonStandard}" />
        <Style x:Key="NMButtonValideOnly" TargetType="Button" BasedOn="{StaticResource NMButtonValide}" />
        <Style TargetType="ComboBox" BasedOn="{StaticResource NMComboBoxStandard}" />
        <Style TargetType="ListBox" BasedOn="{StaticResource NMListBoxStandard}" />
		<Style TargetType="CheckBox" BasedOn="{StaticResource NMCheckBoxStandard}" />
    </Window.Resources>    

    <Grid Margin="5,0,5,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>	<!-- Sélection du répertoire -->
			<RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>	<!-- Liste des dwg détectés -->
			<RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>	<!-- Options de liaisons -->
			<RowDefinition Height="15"/>
			<RowDefinition Height="Auto"/>	<!-- Validation -->
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>  
		
		
		
		<!-- Sélection du répertoire --> 
		<Grid  Grid.Row="0" Grid.Column="0">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/> 
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<TextBlock Text="Dossier :" VerticalAlignment="Center" Grid.Column="0" Margin="5,0,5,0"/>
			<TextBox x:Name="txtFolder" IsReadOnly="True" Grid.Column="1" VerticalAlignment="Center" Margin="0"/>
			<Button x:Name="btnBrowse" Content="Parcourir…" Grid.Column="2" Margin="5,0,5,0" VerticalAlignment="Center"/>
			<CheckBox x:Name="chkIncludeSub" Content="Inclure les sous-dossiers" Margin="0,5,0,0" Grid.Row="1" Grid.Column="1"/>
		</Grid>
                
		
		<!-- Liste des dwg détectés -->
		<Grid Grid.Row="2" Grid.Column="0">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<TextBlock Text="DWG détectés :" Grid.Row="0" Grid.Column="0"/>
        
			<ListBox x:Name="lstDwgs"
					Height="150"
					ScrollViewer.VerticalScrollBarVisibility="Auto"
					IsEnabled="False"
					Grid.Row="1"
					Grid.Column="0"/>
		</Grid>			


		<!-- Options de liaisons -->
		<Grid Grid.Row="4" Grid.Column="0">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>
			
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			
			<TextBlock Text="Couleurs :" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0"/>
			
			<ComboBox x:Name="cmbColorMode" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2">
				<ComboBoxItem>Conserver</ComboBoxItem>
				<ComboBoxItem>Inverser</ComboBoxItem>
				<ComboBoxItem>Noir et blanc</ComboBoxItem>
			</ComboBox>

			<TextBlock Text="Calques :" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0"/>
			
			<ComboBox x:Name="cmbLayers" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2">
				<ComboBoxItem>Tous</ComboBoxItem>
				<ComboBoxItem>Visibles</ComboBoxItem>
				<ComboBoxItem>Spécifier…</ComboBoxItem>
			</ComboBox>

			<TextBlock Text="Unités :" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0"/>
        
			<ComboBox x:Name="cmbUnits" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2">       
				<ComboBoxItem>Mètres</ComboBoxItem>
				<ComboBoxItem>Centimètres</ComboBoxItem>
				<ComboBoxItem>Millimètres</ComboBoxItem>
				<ComboBoxItem>Automatique</ComboBoxItem>
			</ComboBox>

			<TextBlock Text="Positionnement :" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Row="3" Grid.Column="0"/>
			<ComboBox x:Name="cmbPlacement" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2">   
				<ComboBoxItem>Automatique – Emplacement partagé</ComboBoxItem>
				<ComboBoxItem>Automatique – Centre à centre</ComboBoxItem>
				<ComboBoxItem>Automatique – Origine vers origine interne</ComboBoxItem>
			</ComboBox>
        
			<CheckBox x:Name="chkCorrectLines" Content="Corriger les lignes légèrement décalées" Margin="5" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"/>
			
			<CheckBox x:Name="chkViewOnly" Content="Vue active uniquement" Margin="5" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"/>	
        </Grid>	

	
		<!-- Validation -->
		<Grid Grid.Row="6" Grid.Column="0">
			<Grid.RowDefinitions>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>
			
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
		
			<Button x:Name="btnOk" Content="Lier" Style="{StaticResource NMButtonValideOnly}" Grid.Row="0" Grid.Column="1"/>               
        
			<Button x:Name="btnCancel" Content="Annuler" Style="{StaticResource NMButtonValideOnly}" Grid.Row="0" Grid.Column="2"/>
		</Grid>
	</Grid>
</Window>
