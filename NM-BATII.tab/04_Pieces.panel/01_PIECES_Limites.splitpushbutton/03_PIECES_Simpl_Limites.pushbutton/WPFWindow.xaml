<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NM-BATII — Simplifier les limites de pièce"
        Width="440" Height="360"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">

  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="10"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="6"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ═══ Description ═══════════════════════════════════════════════════════ -->
    <Border Grid.Row="0"
            BorderBrush="DodgerBlue" BorderThickness="1" CornerRadius="3"
            Padding="10,8">
      <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#555555" LineHeight="20">
        <Run FontWeight="SemiBold">Simplifie les séparateurs de pièce de la vue plan active :</Run>
        <LineBreak/>
        <Run>&#x2022;&#x00A0;Fusionne tous les segments colinéaires qui se chevauchent</Run>
        <LineBreak/>
        <Run>&#x00A0;&#x00A0;&#x00A0;ou se touchent en un seul segment.</Run>
        <LineBreak/>
        <Run>&#x2022;&#x00A0;Supprime les doublons signalés par les avertissements Revit.</Run>
        <LineBreak/>
        <Run>&#x2022;&#x00A0;Supprime les doublons exacts résiduels.</Run>
        <LineBreak/>
        <Run FontStyle="Italic" Foreground="#888888">Les étapes sont répétées jusqu'à convergence complète.</Run>
      </TextBlock>
    </Border>

    <!-- ═══ Bouton Sélection ══════════════════════════════════════════════════ -->
    <Button Grid.Row="2"
            x:Name="btn_selection"
            Content="Sélection des limites"
            Height="44"
            Style="{DynamicResource NMButtonValide}"
            HorizontalAlignment="Stretch"
            ToolTip="Sélectionnez les séparateurs à traiter dans la vue active"/>

    <!-- ═══ Bouton Toutes ═════════════════════════════════════════════════════ -->
    <Button Grid.Row="4"
            x:Name="btn_toutes"
            Content="Toutes les limites de la vue"
            Height="44"
            Style="{DynamicResource NMButtonValide}"
            HorizontalAlignment="Stretch"
            ToolTip="Traiter tous les séparateurs visibles dans la vue active"/>

    <!-- ═══ Bouton Fermer ═════════════════════════════════════════════════════ -->
    <Button Grid.Row="6"
            x:Name="btn_fermer"
            Content="Fermer"
            Height="32"
            Style="{DynamicResource NMButtonStandard}"
            HorizontalAlignment="Right"
            MinWidth="100"
            IsCancel="True"/>
  </Grid>
</Window>
